@page
@model ITPSystem.Pages.Supervisor.MarksModel
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-primary: #0f7b6c;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }
    .sv-title { color: var(--itp-text); font-weight: 700; margin: 0 0 .35rem; }
    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }
    .sv-card {
        border: 1px solid var(--itp-border);
        border-radius: 18px;
        background: #fff;
        padding: .95rem;
        box-shadow: 0 10px 22px rgba(26, 40, 60, 0.06);
    }
    .sv-actions .btn { border-radius: 12px; }
    .sv-muted { color: var(--itp-muted); }
    .sv-section-divider {
        margin: .6rem 0 1rem;
        border: 0;
        border-top: 1px solid #e2e8f0;
    }
</style>
<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
<h3 class="sv-title">Assessment Mark Sheet</h3>
<div class="mb-3 d-flex justify-content-end gap-2">
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Dashboard">Return to Dashboard</a>
    <a class="btn btn-outline-primary btn-sm" asp-page="/Supervisor/Marks" asp-page-handler="ExportExcel">Export XLSX</a>
</div>

<hr class="sv-section-divider" />

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<form method="post" class="mb-4 sv-card">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Student</label>
            <select class="form-select" asp-for="Input.ApplicationId" required>
                <option value="">Select student</option>
                @foreach (var s in Model.Students)
                {
                    var canMark = Model.FinalReportSubmittedIds.Contains(s.application_id);
                    <option value="@s.application_id" disabled="@(canMark ? null : "disabled")">
                        @s.studentName (@s.studentID)@(canMark ? "" : " - Final report not submitted")
                    </option>
                }
            </select>
            <span asp-validation-for="Input.ApplicationId" class="text-danger"></span>
        </div>
    </div>

    @{
        var currentSection = string.Empty;
    }

    @for (var i = 0; i < Model.RubricDefinitions.Count; i++)
    {
        var def = Model.RubricDefinitions[i];
        var maxValue = def.MaxScore.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (!string.Equals(def.Section, currentSection, StringComparison.Ordinal))
        {
            currentSection = def.Section;
            <h5 class="mt-4">@currentSection</h5>
        }
        <div class="row g-2 align-items-end border rounded p-2 mb-2">
            <div class="col-md-5">
                <label class="form-label">Criteria</label>
                <div class="form-control-plaintext">@def.Item</div>
                <input type="hidden" name="Input.RubricScores[@i].RubricItem" value="@def.Item" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Rating Scale</label>
                <div class="border rounded bg-light p-2 small">
                    @def.RatingScale
                </div>
            </div>
            <div class="col-md-1">
                <label class="form-label">Max</label>
                <div class="form-control-plaintext">@def.MaxScore</div>
                <input type="hidden" name="Input.RubricScores[@i].MaxScore" value="@maxValue" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Score</label>
                @{
                    var maxInt = (int)Math.Floor(def.MaxScore);
                    var currentScore = Model.Input?.RubricScores != null && Model.Input.RubricScores.Count > i
                        ? Model.Input.RubricScores[i].Score
                        : null;
                }
                <select class="form-select" name="Input.RubricScores[@i].Score" required>
                    <option value="">Select</option>
                    @for (var score = 0; score <= maxInt; score++)
                    {
                        var selected = currentScore.HasValue && currentScore.Value == score;
                        <option value="@score" selected="@(selected ? "selected" : null)">@score</option>
                    }
                </select>
            </div>
        </div>
    }

    <div class="mt-3">
        <label class="form-label">Overall Comments</label>
        <textarea class="form-control" asp-for="Input.OverallRemarks" rows="3" required></textarea>
        <span asp-validation-for="Input.OverallRemarks" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Save Assessment</button>
    </div>
</form>

<h5>Student Marks</h5>
<div class="table-responsive">
<table class="table table-bordered table-sm align-middle sv-table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Student ID</th>
            <th>Total Mark</th>
            <th>Final Report</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Summaries)
        {
            <tr>
                <td>@item.StudentName</td>
                <td>@item.StudentId</td>
                <td>@item.TotalScore / @item.TotalMax</td>
                <td>
                    @if (item.FinalReportId.HasValue)
                    {
                        <a asp-page="/Supervisor/ReportView"
                           asp-route-reportId="@item.FinalReportId.Value"
                           asp-route-applicationId="@item.ApplicationId">View Final Report</a>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    @if (item.FinalReportSubmitted)
                    {
                        <a class="btn btn-outline-primary btn-sm"
                           asp-page="/Supervisor/Marks"
                           asp-route-applicationId="@item.ApplicationId">View Details</a>
                    }
                    else
                    {
                        <span class="text-muted">Final report not submitted</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (Model.applicationId.HasValue)
{
    <h5 class="mt-4">Mark Details</h5>
    @if (!Model.DetailItems.Any())
    {
        <div class="alert alert-info">No marks found for the selected student.</div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle sv-table">
            <thead>
                <tr>
                    <th>Rubric</th>
                    <th>Score</th>
                    <th>Max</th>
                    <th>Remarks</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.DetailItems)
                {
                    <tr>
                        <td>@detail.Mark.rubric_item</td>
                        <td>@detail.Mark.score</td>
                        <td>@detail.Mark.max_score</td>
                        <td>@detail.Mark.remarks</td>
                        <td>@detail.Mark.created_at.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}
</div>
</div>
</div>




