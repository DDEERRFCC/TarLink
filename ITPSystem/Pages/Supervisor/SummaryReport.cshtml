@page
@model ITPSystem.Pages.Supervisor.SummaryReportModel
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }
    .sv-title { color: var(--itp-text); font-weight: 700; margin: 0 0 .35rem; }
    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }
    .sv-filter { background: #fff; border: 1px solid var(--itp-border); border-radius: 16px; padding: .85rem; }
    .sv-actions .btn { border-radius: 12px; }
    .sv-alert { border-radius: 12px; }
    .sv-muted { color: var(--itp-muted); }
    .sv-section-divider {
        margin: .6rem 0 1rem;
        border: 0;
        border-top: 1px solid #e2e8f0;
    }
</style>
<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
<h3 class="sv-title">Summary Report</h3>
<p class="sv-muted">Overview by cohort and academic level. Report generated date/time: <strong>@Model.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss")</strong></p>

<div class="mb-3 d-flex justify-content-end">
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Dashboard">Back to Dashboard</a>
</div>

<hr class="sv-section-divider" />

<form method="get" class="sv-filter row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label">Cohort</label>
        <select class="form-select form-select-sm" asp-for="cohortId" asp-items="Model.CohortOptions">
            <option value="">All Cohorts</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Academic Level</label>
        <select class="form-select form-select-sm" asp-for="level">
            <option value="">All Levels</option>
            <option value="0">0 - Unknown</option>
            <option value="1">1 - Diploma</option>
            <option value="2">2 - Degree</option>
            <option value="3">3 - Master</option>
            <option value="4">4 - PhD</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary btn-sm w-100">Go</button>
    </div>
    <div class="col-md-1">
        <a class="btn btn-outline-success btn-sm w-100"
           asp-page-handler="ExportCsv"
           asp-route-cohortId="@Model.cohortId"
           asp-route-level="@Model.level">CSV</a>
    </div>
    <div class="col-md-2">
        <a class="btn btn-outline-success btn-sm w-100"
           asp-page-handler="ExportExcel"
           asp-route-cohortId="@Model.cohortId"
           asp-route-level="@Model.level">Excel</a>
    </div>
</form>

<h5>Student Breakdown by Programme</h5>
<div class="table-responsive">
<table class="table table-bordered table-sm align-middle sv-table">
    <thead>
        <tr>
            <th>Programme</th>
            <th>No of Student</th>
            <th>Success</th>
            <th>Failed</th>
            <th>Pending</th>
            <th>Rejected</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.ProgrammeSummary)
        {
            <tr>
                <td>@row.Programme</td>
                <td>@row.NoOfStudent</td>
                <td>@row.Success</td>
                <td>@row.Failed</td>
                <td>@row.Pending</td>
                <td>@row.Rejected</td>
            </tr>
        }
        <tr class="table-secondary fw-bold">
            <td>Total</td>
            <td>@Model.Totals.TotalStudents</td>
            <td>@Model.Totals.TotalSuccess</td>
            <td>@Model.Totals.TotalFailed</td>
            <td>@Model.Totals.TotalPending</td>
            <td>@Model.Totals.TotalRejected</td>
        </tr>
    </tbody>
</table>
</div>

<h5>Student Breakdown by Company</h5>
<div class="table-responsive">
<table class="table table-bordered table-sm align-middle sv-table">
    <thead>
        <tr>
            <th>Company Name</th>
            <th>Average Allowance</th>
            <th>Applicant Count</th>
            <th>Programme</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.CompanySummary)
        {
            <tr>
                <td>@row.CompanyName</td>
                <td>@row.AverageAllowance.ToString("0.00")</td>
                <td>@row.ApplicantCount</td>
                <td>@(string.IsNullOrWhiteSpace(row.Programmes) ? "-" : row.Programmes)</td>
            </tr>
        }
        <tr class="table-secondary fw-bold">
            <td>Total</td>
            <td>-</td>
            <td>@Model.Totals.TotalApplicantsByCompany</td>
            <td>-</td>
        </tr>
    </tbody>
</table>
</div>
</div>
</div>




