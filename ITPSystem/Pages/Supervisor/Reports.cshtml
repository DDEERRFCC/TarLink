@page
@model ITPSystem.Pages.Supervisor.ReportsModel
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1.2rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }

    .sv-title { color: var(--itp-text); font-weight: 700; }
    .sv-muted { color: var(--itp-muted); }

    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .sv-actions .btn { border-radius: 12px; }
</style>

<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
<h2 class="sv-title">Progress Report Approval</h2>
<p class="sv-muted">Approve or reject submitted student reports.</p>
@if (!string.IsNullOrWhiteSpace(Model.SelectedStudent))
{
    <p class="sv-muted">Showing reports for: <strong>@Model.SelectedStudent</strong></p>
}
<div class="mb-3 d-flex justify-content-end gap-2">
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Dashboard">Back to Dashboard</a>
    <a class="btn btn-outline-primary btn-sm" asp-page="/Supervisor/ReportResults">View Results</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">No submitted reports pending approval.</div>
}

<div class="table-responsive">
<table class="table table-bordered table-sm sv-table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Report</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Content Preview</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.StudentName (@item.StudentId)</td>
                <td>
                    <a asp-page="/Supervisor/ReportView" asp-route-reportId="@item.Report.report_id" asp-route-applicationId="@item.Report.applicantId">
                        @Model.GetReportTitle(item.Report)
                    </a>
                </td>
                <td>@item.Report.dueDate.ToString("yyyy-MM-dd")</td>
                <td>@Model.GetStatusLabel(item.Report.status)</td>
                <td>@(string.IsNullOrWhiteSpace(item.Report.remark) ? "-" : item.Report.remark)</td>
                <td>
                    <form method="post" class="d-flex gap-1 sv-actions">
                        <input type="hidden" name="reportId" value="@item.Report.report_id" />
                        <input type="hidden" name="applicationId" value="@item.Report.applicantId" />
                        <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Remarks" />
                        <button class="btn btn-success btn-sm" type="submit" asp-page-handler="Approve">Approve</button>
                        <button class="btn btn-danger btn-sm" type="submit" asp-page-handler="Reject">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
</div>
</div>
