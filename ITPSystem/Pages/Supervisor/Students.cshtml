@page
@model ITPSystem.Pages.Supervisor.StudentsModel

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-primary: #0f7b6c;
        --itp-primary-dark: #0d5f63;
        --itp-accent: #d97706;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1.3rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }

    .sv-header {
        background: #fff;
        color: var(--itp-text);
        border: 1px solid var(--itp-border);
        border-radius: 16px;
        padding: 1rem 1.1rem;
        margin-bottom: 1rem;
        box-shadow: 0 10px 24px rgba(26, 40, 60, 0.06);
    }

    .sv-filter {
        border: 1px solid var(--itp-border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 14px rgba(15, 23, 42, .06);
        padding: .9rem;
        margin-bottom: 1rem;
    }

    .sv-section-title {
        color: var(--itp-text);
        font-weight: 700;
    }

    .sv-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }
    .sv-chip-approved { background: #dcfce7; color: #166534; }
    .sv-chip-pending { background: #fef9c3; color: #92400e; }
    .sv-chip-rejected { background: #fee2e2; color: #991b1b; }

    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .sv-actions .btn { border-radius: 12px; }
    .sv-actions .btn + .btn { margin-left: .35rem; }
    .sv-muted { color: #607284; }
</style>

<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
    <div class="sv-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <div class="small" style="opacity:.8;">Supervisor Workspace</div>
            <h3 class="mb-0">Student & Internship Tracking</h3>
        </div>
        <a class="btn btn-light btn-sm" asp-page="/Supervisor/Dashboard">Return to Dashboard</a>
    </div>

    <form method="get" class="sv-filter row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Filter by Academic Level</label>
            <select class="form-select form-select-sm" asp-for="level">
                <option value="">All Levels</option>
                <option value="1">1 - Diploma</option>
                <option value="2">2 - Degree</option>
                <option value="3">3 - Master</option>
                <option value="4">4 - PhD</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
        </div>
        <div class="col-md-2">
            <a class="btn btn-outline-secondary btn-sm w-100" asp-page="/Supervisor/Students">Reset</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <h5 class="mt-4 sv-section-title">Pending Applications (Active Cohorts)</h5>
    @if (!Model.CurrentStudents.Any())
    {
        <div class="alert alert-info">No pending applications found for your filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle sv-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Academic</th>
                        <th>Level</th>
                        <th>Company</th>
                        <th>Allowance</th>
                        <th>Supervisor</th>
                        <th>Application Status</th>
                        <th>Supervisor Remark</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.CurrentStudents)
                    {
                        var status = (s.applyStatus ?? string.Empty).Trim().ToLowerInvariant();
                        var chip = status == "approved" ? "sv-chip-approved"
                            : status == "rejected" ? "sv-chip-rejected"
                            : "sv-chip-pending";
                        <tr>
                            <td>@s.studentName<br /><small class="sv-muted">@s.studentID</small></td>
                            <td>CGPA: @(s.CGPA?.ToString("0.00") ?? "-")<br />Programme: @s.programme</td>
                            <td>@ITPSystem.Pages.Supervisor.StudentsModel.GetLevelLabel(s.level)</td>
                            <td>@(s.comName ?? "-")<br /><small class="sv-muted">@(s.comAddress ?? "-")</small></td>
                            <td>@(s.allowance?.ToString("0.00") ?? "-")</td>
                            <td>@(s.comSupervisor ?? "-")<br /><small class="sv-muted">@(s.ucSupervisor ?? "-")</small></td>
                            <td><span class="sv-chip @chip">@s.applyStatus</span></td>
                            <td>@(string.IsNullOrWhiteSpace(s.remark) ? "-" : s.remark)</td>
                            <td>
                                @if (string.Equals(s.applyStatus, "pending", System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" class="mt-2">
                                        <input type="hidden" name="applicationId" value="@s.application_id" />
                                        <input type="text" name="remarks" class="form-control form-control-sm mb-2" placeholder="Reason (required for rejection)" />
                                        <button type="submit" asp-page-handler="Approve" class="btn btn-success btn-sm me-1">Approve</button>
                                        <button type="submit" asp-page-handler="Reject" class="btn btn-danger btn-sm">Reject</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
</div>
</div>

