@page
@model ITPSystem.Pages.Supervisor.NotificationDetailModel
@{
    ViewData["Title"] = "Notification Details";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1.2rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }

    .sv-title { color: var(--itp-text); font-weight: 700; }
    .sv-muted { color: var(--itp-muted); }
    .sv-chip {
        display: inline-flex;
        align-items: center;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }
    .sv-chip-unread { background: #fee2e2; color: #991b1b; }
    .sv-chip-read { background: #dcfce7; color: #166534; }
    .notification-detail {
        background: #f9fbfc;
        border: 1px solid var(--itp-border);
        border-radius: 16px;
        padding: 1.5rem;
        margin: 1rem 0;
    }
    .notification-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }
    .notification-message {
        background: white;
        border: 1px solid var(--itp-border);
        border-radius: 12px;
        padding: 1rem;
        margin: 1rem 0;
        line-height: 1.6;
    }
</style>

<div class="sv-portal">
    <div class="itp-shell">
        <div class="sv-shell">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="sv-title mb-0">Notification Details</h2>
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Notifications">Back to Notifications</a>
            </div>

            @if (Model.Notification == null)
            {
                <div class="alert alert-danger">Notification not found.</div>
            }
            else
            {
                <div class="notification-detail">
                    <div class="notification-header">
                        <div>
                            <h4 class="mb-2">@Model.Notification.title</h4>
                            <p class="sv-muted mb-1">
                                <strong>From:</strong> @(string.IsNullOrWhiteSpace(Model.SenderName) ? "System" : Model.SenderName)
                            </p>
                            <p class="sv-muted mb-1">
                                <strong>Date:</strong> @Model.Notification.created_at.ToString("yyyy-MM-dd HH:mm")
                            </p>
                        </div>
                        <div>
                            @if (Model.Notification.is_read)
                            {
                                <span class="sv-chip sv-chip-read">Read</span>
                            }
                            else
                            {
                                <span class="sv-chip sv-chip-unread">Unread</span>
                            }
                        </div>
                    </div>

                    <hr />

                    <div>
                        <h5>Message</h5>
                        <div class="notification-message">
                            @if (string.IsNullOrWhiteSpace(Model.Notification.message))
                            {
                                <em class="sv-muted">No message provided.</em>
                            }
                            else
                            {
                                @Html.Raw(Model.Notification.message.Replace("\n", "<br />"))
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
