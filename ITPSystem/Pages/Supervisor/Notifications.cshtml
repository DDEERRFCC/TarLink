@page
@model ITPSystem.Pages.Supervisor.NotificationsModel
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1.2rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }
    .sv-title { color: var(--itp-text); font-weight: 700; }
    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }
    .sv-actions .btn { border-radius: 12px; }
    .sv-muted { color: var(--itp-muted); }
    .sv-chip {
        display: inline-flex;
        align-items: center;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }
    .sv-chip-unread { background: #fee2e2; color: #991b1b; }
    .sv-chip-read { background: #dcfce7; color: #166534; }
</style>
<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
<h2 class="sv-title">My Notifications</h2>

<div class="mb-3 d-flex justify-content-end">
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Dashboard">Return to Dashboard</a>
</div>

<form method="post" asp-page-handler="MarkAllRead" class="mb-3">
    <button class="btn btn-outline-secondary btn-sm" type="submit">Mark All As Read</button>
</form>

<div class="table-responsive">
<table class="table table-bordered table-sm align-middle sv-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Title</th>
            <th>Message</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var n in Model.Items)
        {
            <tr>
                <td>@n.created_at.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@n.type</td>
                <td>@n.title</td>
                <td>@n.message</td>
                <td>
                    @if (n.is_read)
                    {
                        <span class="sv-chip sv-chip-read">Read</span>
                    }
                    else
                    {
                        <span class="sv-chip sv-chip-unread">Unread</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
</div>



