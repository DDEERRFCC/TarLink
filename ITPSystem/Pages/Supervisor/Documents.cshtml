@page
@model ITPSystem.Pages.Supervisor.DocumentsModel
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-primary: #0f7b6c;
        --itp-accent: #d97706;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }

    .sv-title { color: var(--itp-text); font-weight: 700; margin: 0 0 .35rem; }
    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }
    .sv-actions .btn { border-radius: 12px; }
    .sv-alert { border-radius: 12px; }
    .sv-link { font-weight: 600; }
    .sv-muted { color: var(--itp-muted); }
    .sv-section-divider {
        margin: .6rem 0 1rem;
        border: 0;
        border-top: 1px solid #e2e8f0;
    }
</style>
<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
<h3 class="sv-title">Document Review</h3>
@if (!string.IsNullOrWhiteSpace(Model.SelectedStudent))
{
    <p class="text-muted" style="color:#14532d; opacity:.7;">Showing documents for: <strong>@Model.SelectedStudent</strong></p>
}
<div class="mb-3 d-flex justify-content-end">
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Dashboard">Back to Dashboard</a>
</div>

<hr class="sv-section-divider" />

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="table-responsive">
<table class="table table-bordered table-sm align-middle sv-table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Company</th>
            <th>Acceptance</th>
            <th>Acknowledgement</th>
            <th>Final/Other</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Students)
        {
            <tr>
                <td>@s.studentName (@s.studentID)</td>
                <td>@s.comName</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(s.formAcceptance))
                    {
                        <div>@s.formAcceptance</div>
                        <div class="d-flex gap-2 mt-1 sv-actions">
                            <a class="sv-link" asp-page-handler="View" asp-route-applicationId="@s.application_id" asp-route-documentType="formAcceptance" target="_blank" rel="noopener">View</a>
                            <a class="sv-link" asp-page-handler="Download" asp-route-applicationId="@s.application_id" asp-route-documentType="formAcceptance">Download</a>
                        </div>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(s.formAcknowledgement))
                    {
                        <div>@s.formAcknowledgement</div>
                        <div class="d-flex gap-2 mt-1 sv-actions">
                            <a class="sv-link" asp-page-handler="View" asp-route-applicationId="@s.application_id" asp-route-documentType="formAcknowledgement" target="_blank" rel="noopener">View</a>
                            <a class="sv-link" asp-page-handler="Download" asp-route-applicationId="@s.application_id" asp-route-documentType="formAcknowledgement">Download</a>
                        </div>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    <div><strong>Letter:</strong> @(s.letterIdentity ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(s.letterIdentity))
                    {
                        <div class="d-flex gap-2 mt-1 mb-1 sv-actions">
                            <a class="sv-link" asp-page-handler="View" asp-route-applicationId="@s.application_id" asp-route-documentType="letterIdentity" target="_blank" rel="noopener">View</a>
                            <a class="sv-link" asp-page-handler="Download" asp-route-applicationId="@s.application_id" asp-route-documentType="letterIdentity">Download</a>
                        </div>
                    }

                    <div><strong>Other:</strong> @(s.otherEvidence ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(s.otherEvidence))
                    {
                        <div class="d-flex gap-2 mt-1 sv-actions">
                            <a class="sv-link" asp-page-handler="View" asp-route-applicationId="@s.application_id" asp-route-documentType="otherEvidence" target="_blank" rel="noopener">View</a>
                            <a class="sv-link" asp-page-handler="Download" asp-route-applicationId="@s.application_id" asp-route-documentType="otherEvidence">Download</a>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
</div>
</div>




