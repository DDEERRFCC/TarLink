@page
@model ITPSystem.Pages.Supervisor.ReportResultsModel
@{
    var finalCount = Model.Items.Count(x => Model.IsFinalReport(x.Report));
    var actionableCount = Model.Items.Count(x => !Model.IsFinalReport(x.Report) && (x.Report.status == 1 || x.Report.status == 4));
}
<style>
    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-primary: #0f7b6c;
        --itp-accent: #d97706;
        --itp-card: rgba(255, 255, 255, 0.88);
        --itp-border: rgba(24, 37, 54, 0.09);
        --itp-hero-start: #132238;
        --itp-hero-mid: #0f7b6c;
        --itp-hero-end: #d97706;
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .report-page {
        display: grid;
        gap: 1rem;
        max-width: 1280px;
        margin: 0 auto;
    }

    .report-toolbar {
        display: flex;
        justify-content: flex-end;
    }

    .report-banner {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 1.35rem;
        color: #fff;
        background: linear-gradient(130deg, var(--itp-hero-start), var(--itp-hero-mid) 58%, var(--itp-hero-end));
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.14);
    }

    .report-banner::after {
        content: "";
        position: absolute;
        right: -42px;
        top: -50px;
        width: 180px;
        height: 180px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        pointer-events: none;
    }

    .report-banner > * { position: relative; z-index: 1; }

    .report-kicker {
        display: inline-flex;
        align-items: center;
        padding: .34rem .72rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .report-title {
        margin: .55rem 0 .35rem;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        font-family: Georgia, "Times New Roman", serif;
    }

    .report-copy {
        margin: 0;
        max-width: 72ch;
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.75;
    }

    .report-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        text-decoration: none;
        border-radius: 999px;
        padding: .78rem 1rem;
        border: 1px solid #d6e6e1;
        background: linear-gradient(180deg, #f9fcfb, #eef7f5);
        color: #13414a;
        font-weight: 700;
        white-space: nowrap;
        position: relative;
        z-index: 3;
        pointer-events: auto;
        cursor: pointer;
    }

    .report-back-btn::before {
        content: "<";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 999px;
        background: #dff3ef;
        color: #0d5f63;
        font-size: .9rem;
        line-height: 1;
    }

    .report-stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .9rem;
    }

    .report-stat,
    .report-panel {
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        background: var(--itp-card);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
    }

    .report-stat {
        position: relative;
        overflow: hidden;
        padding: 1rem 1.05rem;
    }

    .report-stat::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 5px;
        background: linear-gradient(90deg, rgba(15, 123, 108, 0.95), rgba(217, 119, 6, 0.7));
    }

    .report-stat-label {
        color: var(--itp-muted);
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .report-stat-value {
        margin-top: .4rem;
        color: var(--itp-text);
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1;
    }

    .report-panel { padding: 1rem; }

    .report-section-title {
        margin: 0;
        color: var(--itp-text);
        font-size: 1.05rem;
        font-weight: 700;
    }

    .report-section-copy {
        margin: .35rem 0 0;
        color: var(--itp-muted);
        line-height: 1.7;
        font-size: .92rem;
    }

    .report-field label {
        display: block;
        margin-bottom: .35rem;
        color: #36506a;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .report-field .form-select,
    .report-field .form-control {
        min-height: 44px;
        border-radius: 14px;
        border-color: #d1ddea;
        box-shadow: none;
    }

    .report-apply-btn,
    .report-reset-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        border-radius: 14px;
        font-weight: 700;
    }

    .report-apply-btn {
        background: linear-gradient(90deg, var(--itp-primary), var(--itp-accent));
        border: none;
        color: #fff;
    }

    .report-reset-btn {
        background: #fff;
        border: 1px solid #d6e6e1;
        color: #35516a;
        text-decoration: none;
    }

    .report-table {
        margin-bottom: 0;
    }

    .report-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .report-table td,
    .report-table th {
        padding: .8rem .75rem;
        vertical-align: middle;
    }

    .report-action-form {
        display: grid;
        gap: .45rem;
    }

    @@media (max-width: 991.98px) {
        .report-banner-top,
        .report-stat-grid {
            grid-template-columns: 1fr;
            display: grid;
        }
    }
</style>
<div class="sv-portal">
    <div class="itp-shell">
    <div class="report-page">
        <section class="report-banner">
            <div>
                <span class="report-kicker">Supervisor Workflow</span>
                <h1 class="report-title">Report results</h1>
                <p class="report-copy">Track progress submissions, review report decisions, and route final reports into assessment using the same visual language as the committee workspace.</p>
            </div>
        </section>

        <div class="report-toolbar">
            <a class="report-back-btn" href="/Supervisor/Dashboard">Back to dashboard</a>
        </div>

        <section class="report-stat-grid">
            <article class="report-stat">
                <div class="report-stat-label">Students in View</div>
                <div class="report-stat-value">@Model.StudentSummaries.Count</div>
            </article>
            <article class="report-stat">
                <div class="report-stat-label">Actionable Reports</div>
                <div class="report-stat-value">@actionableCount</div>
            </article>
            <article class="report-stat">
                <div class="report-stat-label">Final Reports</div>
                <div class="report-stat-value">@finalCount</div>
            </article>
        </section>

        <section class="report-panel">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <h2 class="report-section-title">Filter report stream</h2>
                    <p class="report-section-copy">Focus the table on one progress slot or show only final reports awaiting assessment context.</p>
                </div>
                @if (Model.applicationId.HasValue)
                {
                    <a class="report-reset-btn" asp-page="/Supervisor/ReportResults">Clear Student Filter</a>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SelectedStudent))
            {
                <p class="mt-3 mb-0 text-muted">Showing reports for <strong>@Model.SelectedStudent</strong>.</p>
            }

            <form method="get" class="row g-3 align-items-end mt-1">
                <div class="col-md-5 report-field">
                    <label>Report Stage</label>
                    <select asp-for="reportFilter" class="form-select">
                        <option value="all">All Reports</option>
                        <option value="p1">Progress Report 1</option>
                        <option value="p2">Progress Report 2</option>
                        <option value="p3">Progress Report 3</option>
                        <option value="p4">Progress Report 4</option>
                        <option value="p5">Progress Report 5</option>
                        <option value="p6">Progress Report 6</option>
                        <option value="f">Final Report</option>
                    </select>
                </div>
                @if (Model.applicationId.HasValue)
                {
                    <input type="hidden" name="applicationId" value="@Model.applicationId.Value" />
                }
                <div class="col-md-2 d-grid">
                    <button type="submit" class="report-apply-btn">Apply</button>
                </div>
            </form>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-success">@Model.Message</div>
        }

        <section class="report-panel">
            <h2 class="report-section-title">Report decisions</h2>
            <p class="report-section-copy">Submitted progress reports can be approved or rejected here. Final reports remain assessment-only.</p>

            @if (!Model.StudentSummaries.Any())
            {
                <div class="alert alert-info mt-3 mb-0">No report records found for your assigned students.</div>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table report-table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Report</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Last Updated</th>
                                <th>Remark</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.StudentSummaries)
                            {
                                @for (var i = 0; i < student.ReportItems.Count; i++)
                                {
                                    var item = student.ReportItems[i];
                                    var isFinalReport = Model.IsFinalReport(item.Report);
                                    <tr>
                                        @if (i == 0)
                                        {
                                            <td rowspan="@student.ReportItems.Count">@student.StudentName (@student.StudentId)</td>
                                        }
                                        <td>
                                            <a asp-page="/Supervisor/ReportView" asp-route-reportId="@item.Report.report_id" asp-route-applicationId="@item.Report.applicantId">
                                                @Model.GetReportTitle(item.Report)
                                            </a>
                                        </td>
                                        <td>@item.Report.dueDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <span class="badge @Model.GetStatusBadgeClass(item.Report.status)">@Model.GetStatusLabel(item.Report.status)</span>
                                            @if (item.IsLate)
                                            {
                                                <span class="badge bg-danger ms-1">Late</span>
                                            }
                                        </td>
                                        <td>@item.Report.updated_at.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Report.remark) ? "-" : item.Report.remark)</td>
                                        <td>
                                            @if (!isFinalReport && (item.Report.status == 1 || item.Report.status == 4))
                                            {
                                                <form method="post" class="report-action-form">
                                                    <input type="hidden" name="reportId" value="@item.Report.report_id" />
                                                    <input type="hidden" name="applicationId" value="@item.Report.applicantId" />
                                                    <input type="hidden" name="reportFilter" value="@Model.reportFilter" />
                                                    <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Remarks" />
                                                    <div class="d-grid gap-2">
                                                        <button class="report-reset-btn" type="submit" asp-page-handler="Approve">Approve</button>
                                                        <button class="btn btn-danger btn-sm" type="submit" asp-page-handler="Reject">Reject</button>
                                                    </div>
                                                </form>
                                            }
                                            else if (isFinalReport)
                                            {
                                                <span class="text-muted">Assessment only</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
    </div>
</div>
