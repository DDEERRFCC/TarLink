@page
@model ITPSystem.Pages.Supervisor.ReportResultsModel
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }
    .sv-title { color: var(--itp-text); font-weight: 700; margin: 0 0 .35rem; }
    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }
    .sv-actions .btn { border-radius: 12px; }
    .sv-filter { background: #fff; border: 1px solid var(--itp-border); border-radius: 16px; padding: .85rem; }
    .sv-alert { border-radius: 12px; }
    .sv-section-divider {
        margin: .6rem 0 1rem;
        border: 0;
        border-top: 1px solid #e2e8f0;
    }
</style>
<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
<h3 class="sv-title">Progress Report Results</h3>
<p class="text-muted" style="color:#14532d; opacity:.7;">See report decisions for each student report (approved/rejected/submitted).</p>

<div class="mb-3 d-flex justify-content-end gap-2">
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Dashboard">Back to Dashboard</a>
    @if (Model.applicationId.HasValue)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/ReportResults">Clear Student Filter</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.SelectedStudent))
{
    <p class="text-muted" style="color:#14532d; opacity:.7;">Showing reports for: <strong>@Model.SelectedStudent</strong></p>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<hr class="sv-section-divider" />

<form method="get" class="sv-filter row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label">Filter by Report Progress</label>
        <select asp-for="reportFilter" class="form-select form-select-sm">
            <option value="all">All Reports</option>
            <option value="p1">Progress Report 1</option>
            <option value="p2">Progress Report 2</option>
            <option value="p3">Progress Report 3</option>
            <option value="p4">Progress Report 4</option>
            <option value="p5">Progress Report 5</option>
            <option value="p6">Progress Report 6</option>
            <option value="f">Final Report</option>
        </select>
    </div>
    @if (Model.applicationId.HasValue)
    {
        <input type="hidden" name="applicationId" value="@Model.applicationId.Value" />
    }
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
    </div>
</form>

@if (!Model.StudentSummaries.Any())
{
    <div class="alert alert-info">No report records found for your assigned students.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-bordered table-sm align-middle sv-table">
        <thead>
            <tr>
                <th>Student</th>
                <th>Report</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Last Updated</th>
                <th>Remark</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.StudentSummaries)
            {
                @for (var i = 0; i < student.ReportItems.Count; i++)
                {
                    var item = student.ReportItems[i];
                    <tr>
                        @if (i == 0)
                        {
                            <td rowspan="@student.ReportItems.Count">@student.StudentName (@student.StudentId)</td>
                        }
                        <td>
                            <a asp-page="/Supervisor/ReportView" asp-route-reportId="@item.Report.report_id" asp-route-applicationId="@item.Report.applicantId">
                                @Model.GetReportTitle(item.Report)
                            </a>
                        </td>
                        <td>@item.Report.dueDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @Model.GetStatusBadgeClass(item.Report.status)">@Model.GetStatusLabel(item.Report.status)</span>
                            @if (item.IsLate)
                            {
                                <span class="badge bg-danger ms-1">Late</span>
                            }
                        </td>
                        <td>@item.Report.updated_at.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Report.remark) ? "-" : item.Report.remark)</td>
                        <td>
                            @if (item.Report.status == 1 || item.Report.status == 4)
                            {
                                <form method="post" class="sv-actions d-flex gap-1">
                                    <input type="hidden" name="reportId" value="@item.Report.report_id" />
                                    <input type="hidden" name="applicationId" value="@item.Report.applicantId" />
                                    <input type="hidden" name="reportFilter" value="@Model.reportFilter" />
                                    <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Remarks" />
                                    <button class="btn btn-success btn-sm" type="submit" asp-page-handler="Approve">Approve</button>
                                    <button class="btn btn-danger btn-sm" type="submit" asp-page-handler="Reject">Reject</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
}
</div>
</div>
</div>




