@page
@model ITPSystem.Pages.Supervisor.ProfileModel
@{
    ViewData["Title"] = "Supervisor Profile";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1.2rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }
    .sv-title { color: var(--itp-text); font-weight: 700; }
    .sv-card {
        border-radius: 18px;
        border: 1px solid var(--itp-border);
        box-shadow: 0 10px 22px rgba(26, 40, 60, 0.06);
    }
    .sv-card-header-plain {
        background: transparent;
        border-bottom: 1px solid #e2e8f0;
        color: #0f172a;
    }
    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }
    .sv-table-plain th {
        background: transparent;
        color: #0f172a;
        font-weight: 600;
    }
    .sv-chip {
        display: inline-flex;
        align-items: center;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }
    .sv-chip-approved { background: #dcfce7; color: #166534; }
    .sv-chip-pending { background: #fef9c3; color: #92400e; }
    .sv-chip-rejected { background: #fee2e2; color: #991b1b; }
</style>

<div class="sv-portal">
<div class="itp-shell">
<div class="sv-shell">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1 sv-title">Supervisor Profile</h2>
            <div class="text-muted" style="color:#14532d; opacity:.7;">Complete account and supervision overview</div>
        </div>
        <a asp-page="/Supervisor/Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (Model.Supervisor == null)
    {
        <div class="alert alert-danger">Profile data could not be loaded.</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="card sv-card"><div class="card-body"><strong>@Model.AssignedStudents</strong><br />Assigned Students</div></div>
            </div>
            <div class="col-md-3">
                <div class="card sv-card"><div class="card-body"><strong>@Model.PendingReports</strong><br />Pending Reports</div></div>
            </div>
            <div class="col-md-3">
                <div class="card sv-card"><div class="card-body"><strong>@Model.DocumentReviewsPending</strong><br />Pending Doc Reviews</div></div>
            </div>
            <div class="col-md-3">
                <div class="card sv-card"><div class="card-body"><strong>@Model.UnreadNotifications</strong><br />Unread Notifications</div></div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card h-100 sv-card">
                    <div class="card-header sv-card-header-plain"><strong>Account Details</strong></div>
                    <div class="card-body">
                        <table class="table table-sm mb-0 sv-table sv-table-plain">
                            <tr><th style="width: 40%;">Username</th><td>@Model.Supervisor.username</td></tr>
                            <tr><th>Email</th><td>@Model.Supervisor.email</td></tr>
                            <tr><th>IC Number</th><td>@(string.IsNullOrWhiteSpace(Model.Supervisor.ic_number) ? "-" : Model.Supervisor.ic_number)</td></tr>
                            <tr><th>Role</th><td>@Model.Supervisor.role</td></tr>
                            <tr><th>Account Active</th><td>@(Model.Supervisor.is_active ? "Yes" : "No")</td></tr>
                            <tr><th>Account Locked</th><td>@(Model.Supervisor.is_locked ? "Yes" : "No")</td></tr>
                            <tr><th>Login Attempts</th><td>@Model.Supervisor.login_attempts</td></tr>
                            <tr><th>Last Login</th><td>@(Model.Supervisor.last_login_at?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td></tr>
                            <tr><th>Password Changed</th><td>@(Model.Supervisor.password_changed_at?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td></tr>
                            <tr><th>Email Verified</th><td>@(Model.Supervisor.email_verified_at?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td></tr>
                            <tr><th>Created At</th><td>@Model.Supervisor.created_at.ToString("dd MMM yyyy, hh:mm tt")</td></tr>
                            <tr><th>Updated At</th><td>@Model.Supervisor.updated_at.ToString("dd MMM yyyy, hh:mm tt")</td></tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card mb-3 sv-card">
                    <div class="card-header"><strong>Application Summary</strong></div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4"><div class="h4 mb-0">@Model.PendingApplications</div><small>Pending</small></div>
                            <div class="col-4"><div class="h4 mb-0">@Model.ApprovedApplications</div><small>Approved</small></div>
                            <div class="col-4"><div class="h4 mb-0">@Model.RejectedApplications</div><small>Rejected</small></div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3 sv-card">
                    <div class="card-header"><strong>Progress Report Summary</strong></div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4"><div class="h4 mb-0">@Model.PendingReports</div><small>Pending</small></div>
                            <div class="col-4"><div class="h4 mb-0">@Model.ApprovedReports</div><small>Approved</small></div>
                            <div class="col-4"><div class="h4 mb-0">@Model.RejectedReports</div><small>Rejected</small></div>
                        </div>
                    </div>
                </div>

                <div class="card sv-card">
                    <div class="card-header"><strong>Document Review Summary</strong></div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4"><div class="h4 mb-0">@Model.DocumentReviewsPending</div><small>Pending</small></div>
                            <div class="col-4"><div class="h4 mb-0">@Model.DocumentReviewsApproved</div><small>Approved</small></div>
                            <div class="col-4"><div class="h4 mb-0">@Model.DocumentReviewsRejected</div><small>Rejected</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-8">
                <div class="card sv-card">
                    <div class="card-header"><strong>Assigned Students</strong></div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0 sv-table">
                                <thead>
                                    <tr>
                                        <th>Student Name</th>
                                        <th>Student ID</th>
                                        <th>Email</th>
                                        <th>Company</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.AssignedStudentList.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-center py-3">No assigned students.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var s in Model.AssignedStudentList)
                                        {
                                            <tr>
                                                <td>@s.studentName</td>
                                                <td>@s.studentID</td>
                                                <td>@s.studentEmail</td>
                                                <td>@(string.IsNullOrWhiteSpace(s.comName) ? "-" : s.comName)</td>
                                                <td>
                                                    @{
                                                        var status = (s.applyStatus ?? string.Empty).Trim().ToLowerInvariant();
                                                        var chip = status == "approved" ? "sv-chip-approved"
                                                            : status == "rejected" ? "sv-chip-rejected"
                                                            : "sv-chip-pending";
                                                    }
                                                    <span class="sv-chip @chip">@s.applyStatus</span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100 sv-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Recent Notifications</strong>
                        <span class="badge bg-secondary">@Model.TotalNotifications total</span>
                    </div>
                    <div class="card-body">
                        @if (Model.RecentNotifications.Count == 0)
                        {
                            <div class="text-muted">No notifications yet.</div>
                        }
                        else
                        {
                            @foreach (var n in Model.RecentNotifications)
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <div class="d-flex justify-content-between">
                                        <strong>@n.title</strong>
                                        <small class="text-muted">@n.created_at.ToLocalTime().ToString("dd MMM")</small>
                                    </div>
                                    <div class="small text-muted">@n.type</div>
                                    <div class="small">@(!string.IsNullOrWhiteSpace(n.message) ? n.message : "-")</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</div>
</div>




