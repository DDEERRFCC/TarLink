@page
@model ITPSystem.Pages.Supervisor.ProfileModel
@{
    ViewData["Title"] = "Supervisor Profile";
}

<style>
    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-primary: #0f7b6c;
        --itp-primary-dark: #0d5f63;
        --itp-accent: #d97706;
        --itp-card: rgba(255, 255, 255, 0.88);
        --itp-border: rgba(24, 37, 54, 0.09);
        --itp-hero-start: #132238;
        --itp-hero-mid: #0f7b6c;
        --itp-hero-end: #d97706;
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .profile-page {
        display: grid;
        gap: 1rem;
        max-width: 1280px;
        margin: 0 auto;
    }

    .profile-toolbar {
        display: flex;
        justify-content: flex-end;
    }

    .profile-banner {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 1.35rem;
        color: #fff;
        background: linear-gradient(130deg, var(--itp-hero-start), var(--itp-hero-mid) 58%, var(--itp-hero-end));
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.14);
    }

    .profile-banner::after {
        content: "";
        position: absolute;
        right: -42px;
        top: -50px;
        width: 180px;
        height: 180px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        pointer-events: none;
    }

    .profile-banner > * {
        position: relative;
        z-index: 1;
    }

    .profile-kicker {
        display: inline-flex;
        align-items: center;
        padding: .34rem .72rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .profile-title {
        margin: .55rem 0 .35rem;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        font-family: Georgia, "Times New Roman", serif;
    }

    .profile-copy {
        margin: 0;
        max-width: 70ch;
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.75;
    }

    .profile-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        text-decoration: none;
        border-radius: 999px;
        padding: .78rem 1rem;
        border: 1px solid #d6e6e1;
        background: linear-gradient(180deg, #f9fcfb, #eef7f5);
        color: #13414a;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06);
        position: relative;
        z-index: 3;
        pointer-events: auto;
        cursor: pointer;
    }

    .profile-back-btn::before {
        content: "<";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 999px;
        background: #dff3ef;
        color: #0d5f63;
        font-size: .9rem;
        line-height: 1;
    }

    .profile-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .9rem;
    }

    .profile-stat,
    .profile-panel {
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        background: var(--itp-card);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
    }

    .profile-stat {
        position: relative;
        overflow: hidden;
        padding: 1rem 1.05rem;
    }

    .profile-stat::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 5px;
        background: linear-gradient(90deg, rgba(15, 123, 108, 0.95), rgba(217, 119, 6, 0.7));
    }

    .profile-stat-label {
        color: var(--itp-muted);
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .profile-stat-value {
        margin-top: .4rem;
        color: var(--itp-text);
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
        gap: 1rem;
        align-items: start;
    }

    .profile-panel {
        overflow: hidden;
    }

    .profile-panel-head {
        padding: 1rem;
        border-bottom: 1px solid #e5eef7;
        background: linear-gradient(180deg, #ffffff, #f7fbfa);
    }

    .profile-panel-head strong {
        color: var(--itp-text);
        font-size: 1rem;
    }

    .profile-panel-body {
        padding: 1rem;
    }

    .profile-table {
        margin-bottom: 0;
    }

    .profile-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .profile-table td,
    .profile-table th {
        padding: .8rem .75rem;
        vertical-align: middle;
    }

    .profile-chip {
        display: inline-flex;
        align-items: center;
        padding: .24rem .65rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
    }

    .profile-chip-approved { background: #dcfce7; color: #166534; }
    .profile-chip-pending { background: #fef3c7; color: #92400e; }
    .profile-chip-rejected { background: #fee2e2; color: #991b1b; }

    .profile-metric-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem;
    }

    .profile-mini-card {
        border: 1px solid var(--itp-border);
        border-radius: 18px;
        padding: .95rem;
        background: #fff;
    }

    .profile-mini-label {
        color: var(--itp-muted);
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .profile-mini-value {
        margin-top: .35rem;
        color: var(--itp-text);
        font-size: 1.35rem;
        font-weight: 700;
    }

    .profile-note {
        color: #7a6673;
        line-height: 1.7;
    }

    @@media (max-width: 991.98px) {
        .profile-banner-top,
        .profile-grid {
            grid-template-columns: 1fr;
            display: grid;
        }

        .profile-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .profile-stat-grid,
        .profile-metric-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="sv-portal">
    <div class="itp-shell">
    <div class="profile-page">
        <section class="profile-banner">
            <div>
                <span class="profile-kicker">Supervisor Centre</span>
                <h1 class="profile-title">Profile & supervision overview</h1>
                <p class="profile-copy">Review your account profile, assigned students, report workload, and recent student activity from one place.</p>
            </div>
        </section>

        <div class="profile-toolbar">
            <a href="/Supervisor/Dashboard" class="profile-back-btn">Back to dashboard</a>
        </div>

        @if (Model.Supervisor == null)
        {
            <div class="alert alert-danger">Profile data could not be loaded.</div>
        }
        else
        {
            <section class="profile-stat-grid">
                <article class="profile-stat">
                    <div class="profile-stat-label">Assigned Students</div>
                    <div class="profile-stat-value">@Model.AssignedStudents</div>
                </article>
                <article class="profile-stat">
                    <div class="profile-stat-label">Pending Reports</div>
                    <div class="profile-stat-value">@Model.PendingReports</div>
                </article>
                <article class="profile-stat">
                    <div class="profile-stat-label">Pending Doc Reviews</div>
                    <div class="profile-stat-value">@Model.DocumentReviewsPending</div>
                </article>
                <article class="profile-stat">
                    <div class="profile-stat-label">Unread Notifications</div>
                    <div class="profile-stat-value">@Model.UnreadNotifications</div>
                </article>
            </section>

            <section class="profile-grid">
                <article class="profile-panel">
                    <div class="profile-panel-head">
                        <strong>Account Details</strong>
                    </div>
                    <div class="profile-panel-body">
                        <table class="table profile-table">
                            <tbody>
                                <tr><th style="width:34%;">Staff ID</th><td>@Model.Supervisor.staffId</td></tr>
                                <tr><th>Name</th><td>@Model.Supervisor.name</td></tr>
                                <tr><th>Email</th><td>@Model.Supervisor.email</td></tr>
                                <tr><th>Contact</th><td>@(string.IsNullOrWhiteSpace(Model.Supervisor.contact) ? "-" : Model.Supervisor.contact)</td></tr>
                                <tr><th>Faculty</th><td>@(string.IsNullOrWhiteSpace(Model.Supervisor.faculty) ? "-" : Model.Supervisor.faculty)</td></tr>
                                <tr><th>Campus</th><td>@(string.IsNullOrWhiteSpace(Model.Supervisor.campus) ? "-" : Model.Supervisor.campus)</td></tr>
                                <tr><th>Account Active</th><td>@(Model.Supervisor.isActive ? "Yes" : "No")</td></tr>
                                <tr><th>Committee Access</th><td>@(Model.Supervisor.isCommittee ? "Yes" : "No")</td></tr>
                                <tr><th>Remark</th><td>@(string.IsNullOrWhiteSpace(Model.Supervisor.remark) ? "-" : Model.Supervisor.remark)</td></tr>
                                <tr><th>Created At</th><td>@Model.Supervisor.created_at.ToString("dd MMM yyyy, hh:mm tt")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </article>

                <div class="d-grid gap-3">
                    <article class="profile-panel">
                        <div class="profile-panel-head">
                            <strong>Application Summary</strong>
                        </div>
                        <div class="profile-panel-body">
                            <div class="profile-metric-grid">
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Pending</div>
                                    <div class="profile-mini-value">@Model.PendingApplications</div>
                                </div>
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Approved</div>
                                    <div class="profile-mini-value">@Model.ApprovedApplications</div>
                                </div>
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Rejected</div>
                                    <div class="profile-mini-value">@Model.RejectedApplications</div>
                                </div>
                            </div>
                        </div>
                    </article>

                    <article class="profile-panel">
                        <div class="profile-panel-head">
                            <strong>Report Summary</strong>
                        </div>
                        <div class="profile-panel-body">
                            <div class="profile-metric-grid">
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Pending</div>
                                    <div class="profile-mini-value">@Model.PendingReports</div>
                                </div>
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Approved</div>
                                    <div class="profile-mini-value">@Model.ApprovedReports</div>
                                </div>
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Rejected</div>
                                    <div class="profile-mini-value">@Model.RejectedReports</div>
                                </div>
                            </div>
                        </div>
                    </article>

                    <article class="profile-panel">
                        <div class="profile-panel-head">
                            <strong>Document Review Summary</strong>
                        </div>
                        <div class="profile-panel-body">
                            <div class="profile-metric-grid">
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Pending</div>
                                    <div class="profile-mini-value">@Model.DocumentReviewsPending</div>
                                </div>
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Approved</div>
                                    <div class="profile-mini-value">@Model.DocumentReviewsApproved</div>
                                </div>
                                <div class="profile-mini-card">
                                    <div class="profile-mini-label">Rejected</div>
                                    <div class="profile-mini-value">@Model.DocumentReviewsRejected</div>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            </section>

            <section class="profile-grid">
                <article class="profile-panel">
                    <div class="profile-panel-head">
                        <strong>Assigned Students</strong>
                    </div>
                    <div class="profile-panel-body p-0">
                        <div class="table-responsive">
                            <table class="table profile-table">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>ID</th>
                                        <th>Email</th>
                                        <th>Company</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.AssignedStudentList.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-center py-4">No assigned students.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var s in Model.AssignedStudentList)
                                        {
                                            var status = (s.applyStatus ?? string.Empty).Trim().ToLowerInvariant();
                                            var chip = status == "approved" ? "profile-chip-approved"
                                                : status == "rejected" ? "profile-chip-rejected"
                                                : "profile-chip-pending";
                                            <tr>
                                                <td>@s.studentName</td>
                                                <td>@s.studentID</td>
                                                <td>@s.studentEmail</td>
                                                <td>@(string.IsNullOrWhiteSpace(s.comName) ? "-" : s.comName)</td>
                                                <td><span class="profile-chip @chip">@s.applyStatus</span></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </article>

                <article class="profile-panel">
                    <div class="profile-panel-head">
                        <strong>Recent Notifications</strong>
                    </div>
                    <div class="profile-panel-body">
                        @if (Model.RecentNotifications.Count == 0)
                        {
                            <p class="profile-note mb-0">No notifications are available yet.</p>
                        }
                        else
                        {
                            @foreach (var n in Model.RecentNotifications)
                            {
                                <div class="border-bottom pb-3 mb-3">
                                    <div class="d-flex justify-content-between gap-2">
                                        <strong>@n.title</strong>
                                        <small class="text-muted">@n.created_at.ToLocalTime().ToString("dd MMM")</small>
                                    </div>
                                    <div class="small text-muted">@n.type</div>
                                    <div class="small mt-1">@(!string.IsNullOrWhiteSpace(n.message) ? n.message : "-")</div>
                                </div>
                            }
                        }
                    </div>
                </article>
            </section>
        }
    </div>
    </div>
</div>
