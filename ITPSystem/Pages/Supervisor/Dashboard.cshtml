@page
@model ITPSystem.Pages.Supervisor.DashboardModel

<style>
    .sv-shell {
        background: #f0fdf4;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1rem 1.1rem 1.25rem;
    }
    .sv-page { padding-bottom: 1.5rem; }
    .sv-hero {
        background: #14532d;
        color: #fff;
        border-radius: 12px;
        padding: .9rem 1rem;
        margin-bottom: 1rem;
    }
    .sv-kpi {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #f0fdf4;
        padding: .7rem;
        text-align: center;
        min-height: 90px;
    }
    .sv-kpi .value { font-size: 1.35rem; font-weight: 700; }
    .sv-actions .btn { border-radius: 10px; }
    .sv-actions .sv-action-accent {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }
    .sv-actions .sv-action-accent:hover {
        background: #15803d;
        border-color: #15803d;
        color: #fff;
    }
    .sv-actions .btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }
    .sv-actions .btn-primary:hover {
        background: #15803d;
        border-color: #15803d;
    }
    .sv-actions .btn-outline-secondary {
        background: #f0fdf4;
        border-color: #cbd5e1;
        color: #0f172a;
    }
    .sv-actions .btn-outline-secondary:hover {
        background: #f1f5f9;
        border-color: #94a3b8;
        color: #0f172a;
    }
    .sv-table { table-layout: fixed; width: 100%; }
    .sv-table th { background: #f1f5f9; width: 20%; }
    .sv-card-header {
        background: #f1f5f9;
        color: #0f172a;
        font-weight: 600;
        border-bottom: 1px solid #e2e8f0;
    }
    .sv-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }
    .sv-chip-approved { background: #dcfce7; color: #166534; }
    .sv-chip-pending { background: #fef9c3; color: #92400e; }
    .sv-chip-rejected { background: #fee2e2; color: #991b1b; }
</style>

<div class="sv-shell">
<div class="sv-page">
    <div class="sv-hero">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <div style="opacity:.85; font-size:.9rem;">Supervisor Dashboard</div>
                <h3 class="mb-0">Welcome, @Model.UserName!</h3>
            </div>
            <a class="btn btn-light btn-sm" asp-page="/Supervisor/Notifications">Notifications</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="sv-kpi"><div class="value">@Model.PendingReports</div><div class="text-muted small">Pending Reports</div></div>
        </div>
        <div class="col-md-2">
            <div class="sv-kpi"><div class="value">@Model.PendingDocuments</div><div class="text-muted small">Pending Documents</div></div>
        </div>
        <div class="col-md-2">
            <div class="sv-kpi"><div class="value">@Model.PendingApplications</div><div class="text-muted small">Pending Applications</div></div>
        </div>
        <div class="col-md-2">
            <div class="sv-kpi"><div class="value">@Model.ActiveInternships</div><div class="text-muted small">Active Internships</div></div>
        </div>
        <div class="col-md-2">
            <div class="sv-kpi"><div class="value">@Model.UnreadNotifications</div><div class="text-muted small">Unread Notifications</div></div>
        </div>
    </div>

    <div class="sv-actions d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-primary" asp-page="/Supervisor/Profile">My Profile</a>
        <a class="btn sv-action-accent" asp-page="/Supervisor/Students">Student Applications</a>
        <a class="btn sv-action-accent" asp-page="/Supervisor/ReportResults">Report Results</a>
        <a class="btn sv-action-accent" asp-page="/Supervisor/Documents">Documents</a>
        <a class="btn sv-action-accent" asp-page="/Supervisor/Marks">Assessment Marks</a>
        <a class="btn sv-action-accent" asp-page="/Supervisor/SummaryReport">Summary Report</a>
    </div>

    <h5>My Assigned Students</h5>
    @if (!Model.CohortGroups.Any())
    {
        <div class="text-muted">No assigned students.</div>
    }
    else
    {
        @foreach (var group in Model.CohortGroups)
        {
            <div class="card mb-3">
                <div class="card-header sv-card-header">Cohort @group.CohortLabel</div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0 sv-table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>ID</th>
                                <th>Company</th>
                                <th>Status</th>
                                <th>Allowance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in group.Students)
                            {
                                var status = (s.applyStatus ?? string.Empty).Trim().ToLowerInvariant();
                                var chip = status == "approved" ? "sv-chip-approved"
                                    : status == "rejected" ? "sv-chip-rejected"
                                    : "sv-chip-pending";
                                <tr>
                                    <td>@s.studentName</td>
                                    <td>@s.studentID</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.comName) ? "-" : s.comName)</td>
                                    <td><span class="sv-chip @chip">@s.applyStatus</span></td>
                                    <td>@(s.allowance?.ToString("0.00") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
</div>



