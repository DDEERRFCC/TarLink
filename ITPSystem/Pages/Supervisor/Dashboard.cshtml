@page
@model ITPSystem.Pages.Supervisor.DashboardModel

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-primary: #0f7b6c;
        --itp-primary-dark: #0d5f63;
        --itp-accent: #d97706;
        --itp-card: rgba(255, 255, 255, 0.88);
        --itp-border: rgba(24, 37, 54, 0.09);
        --itp-hero-start: #132238;
        --itp-hero-mid: #0f7b6c;
        --itp-hero-end: #d97706;
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(130deg, var(--itp-hero-start), var(--itp-hero-mid) 58%, var(--itp-hero-end));
        color: #fffdf7;
        border-radius: 28px;
        padding: 1.8rem;
        box-shadow: 0 22px 48px rgba(19, 34, 56, 0.18);
        animation: fade-up .5s ease-out;
    }

    .sv-hero::before,
    .sv-hero::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        opacity: .24;
        pointer-events: none;
    }

    .sv-hero::before {
        width: 240px;
        height: 240px;
        top: -80px;
        right: -60px;
        background: rgba(255, 255, 255, 0.16);
    }

    .sv-hero::after {
        width: 180px;
        height: 180px;
        left: -50px;
        bottom: -80px;
        background: rgba(255, 255, 255, 0.12);
    }

    .sv-hero-layout {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.2rem;
    }

    .sv-hero-content {
        flex: 1;
        min-width: 0;
    }

    .sv-hero-title {
        margin: .8rem 0 .45rem;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.6rem, 3.2vw, 2.4rem);
        line-height: 1.05;
        letter-spacing: -.03em;
    }

    .sv-hero-copy {
        max-width: 56ch;
        margin-bottom: 1rem;
        color: rgba(255, 253, 247, 0.88);
        line-height: 1.8;
    }

    .sv-hero-actions {
        display: flex;
        flex-direction: column;
        gap: .6rem;
        align-items: flex-end;
        flex-shrink: 0;
    }

    .sv-hero-actions .btn {
        border-radius: 999px;
        padding: .55rem .9rem;
        font-weight: 700;
    }

    .sv-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: .9rem;
        margin: 1.2rem 0 1.4rem;
    }

    .sv-card {
        position: relative;
        overflow: hidden;
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        backdrop-filter: blur(10px);
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        animation: fade-up .55s ease-out;
    }

    .sv-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 5px;
        background: linear-gradient(90deg, rgba(15, 123, 108, 0.95), rgba(217, 119, 6, 0.7));
        opacity: .9;
    }

    .sv-kpi-label {
        color: var(--itp-muted);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .sv-kpi-value {
        margin-top: .35rem;
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--itp-text);
    }

    .sv-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .75rem;
        margin-bottom: 1.4rem;
    }

    .sv-action {
        text-decoration: none;
        background: linear-gradient(180deg, #f9fcfb, #eef7f5);
        border: 1px solid #d6e6e1;
        color: #13414a;
        border-radius: 16px;
        padding: .85rem .95rem;
        font-weight: 700;
        transition: all .2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: .6rem;
    }

    .sv-action:hover {
        transform: translateY(-1px);
        border-color: #89cce8;
        color: #0d3344;
    }

    .sv-section-title {
        color: var(--itp-text);
        font-weight: 700;
        margin: 0 0 .8rem;
        font-size: 1.1rem;
    }

    .sv-table {
        table-layout: fixed;
        width: 100%;
    }

    .sv-table-assigned {
        table-layout: auto;
    }

    .sv-table-assigned .sv-col-id {
        width: 8.5rem;
        white-space: nowrap;
    }

    .sv-table-assigned .sv-col-email {
        min-width: 18rem;
    }

    .sv-table-assigned td.sv-email-cell,
    .sv-table-assigned th.sv-col-email {
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .sv-table thead th {
        background: #f6fafc;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .sv-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }

    .sv-chip-approved { background: #dcfce7; color: #166534; }
    .sv-chip-pending { background: #fef9c3; color: #92400e; }
    .sv-chip-rejected { background: #fee2e2; color: #991b1b; }

    @@media (max-width: 1199.98px) {
        .sv-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sv-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 767.98px) {
        .sv-hero-layout { grid-template-columns: 1fr; }
        .sv-grid { grid-template-columns: 1fr; }
        .sv-actions { grid-template-columns: 1fr; }
    }
</style>

<div class="sv-portal">
<div class="itp-shell">
    <section class="sv-hero">
        <div class="sv-hero-layout">
            <div class="sv-hero-content">
                <div style="opacity:.85; font-size:.9rem;">Supervisor Dashboard</div>
                <h3 class="sv-hero-title">Welcome, @Model.UserName!</h3>
                <p class="sv-hero-copy">Monitor student placements, track reviews, and manage approvals in one place.</p>
            </div>
            <div class="sv-hero-actions">
                <a class="btn btn-light btn-sm" asp-page="/Supervisor/Notifications">Notifications</a>
            </div>
        </div>
    </section>

    <section class="sv-grid">
        <div class="sv-card">
            <div class="sv-kpi-label">Pending Reports</div>
            <div class="sv-kpi-value">@Model.PendingReports</div>
        </div>
        <div class="sv-card">
            <div class="sv-kpi-label">Pending Documents</div>
            <div class="sv-kpi-value">@Model.PendingDocuments</div>
        </div>
        <div class="sv-card">
            <div class="sv-kpi-label">Pending Applications</div>
            <div class="sv-kpi-value">@Model.PendingApplications</div>
        </div>
        <div class="sv-card">
            <div class="sv-kpi-label">Active Internships</div>
            <div class="sv-kpi-value">@Model.ActiveInternships</div>
        </div>
        <div class="sv-card">
            <div class="sv-kpi-label">Unread Notifications</div>
            <div class="sv-kpi-value">@Model.UnreadNotifications</div>
        </div>
    </section>

    <section class="sv-actions">
        <a class="sv-action" asp-page="/Supervisor/Profile">My Profile</a>
        <a class="sv-action" asp-page="/Supervisor/Students">Student Applications</a>
        <a class="sv-action" asp-page="/Supervisor/ReportResults">Report Results</a>
        <a class="sv-action" asp-page="/Supervisor/Documents">Documents</a>
        <a class="sv-action" asp-page="/Supervisor/Marks">Assessment Marks</a>
        <a class="sv-action" asp-page="/Supervisor/SummaryReport">Summary Report</a>
    </section>

    <h5 class="sv-section-title">My Assigned Students</h5>
    @if (!Model.CohortGroups.Any())
    {
        <div class="sv-card">No assigned students.</div>
    }
    else
    {
        @foreach (var group in Model.CohortGroups)
        {
            <div class="sv-card mb-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                    <strong>@group.CohortLabel</strong>
                    <span class="text-muted small">@group.Students.Count student(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0 sv-table sv-table-assigned">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th class="sv-col-id">ID</th>
                                <th class="sv-col-email">Email</th>
                                <th>Company</th>
                                <th>Status</th>
                                <th>Allowance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in group.Students)
                            {
                                var status = (s.applyStatus ?? string.Empty).Trim().ToLowerInvariant();
                                var chip = status == "approved" ? "sv-chip-approved"
                                    : status == "rejected" ? "sv-chip-rejected"
                                    : "sv-chip-pending";
                                <tr>
                                    <td>@s.studentName</td>
                                    <td>@s.studentID</td>
                                    <td class="sv-email-cell">@(string.IsNullOrWhiteSpace(s.studentEmail) ? "-" : s.studentEmail)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.comName) ? "-" : s.comName)</td>
                                    <td><span class="sv-chip @chip">@s.applyStatus</span></td>
                                    <td>@(s.allowance?.ToString("0.00") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
</div>


