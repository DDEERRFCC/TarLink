@page
@model ITPSystem.Pages.Supervisor.SendNotificationModel
@{
    ViewData["Title"] = "Send Notification";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-card: rgba(255, 255, 255, 0.9);
        --itp-border: rgba(24, 37, 54, 0.09);
    }

    .sv-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .sv-shell {
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        border-radius: 22px;
        padding: 1.2rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        backdrop-filter: blur(10px);
    }

    .sv-title { color: var(--itp-text); font-weight: 700; }
    .sv-form-group {
        margin-bottom: 1.5rem;
    }
    .form-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--itp-text);
    }
    .form-control {
        border-radius: 10px;
        border: 1px solid var(--itp-border);
        padding: 0.6rem 0.8rem;
        font-family: "Space Grotesk", sans-serif;
    }
    .form-control:focus {
        border-color: #0f7b6c;
        box-shadow: 0 0 0 3px rgba(15, 123, 108, 0.1);
    }
    .student-list {
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid var(--itp-border);
        border-radius: 10px;
        padding: 1rem;
        background: #f9fbfc;
    }
    .student-item {
        padding: 0.6rem 0.8rem;
        border-bottom: 1px solid var(--itp-border);
        display: flex;
        align-items: center;
    }
    .student-item:last-child {
        border-bottom: none;
    }
    .student-item input[type="checkbox"] {
        margin-right: 0.8rem;
    }
    .btn-primary {
        background: linear-gradient(135deg, #0f7b6c 0%, #0f7b6c);
        border: none;
        border-radius: 10px;
        padding: 0.6rem 1.5rem;
        font-weight: 600;
    }
    .btn-outline-secondary {
        border-radius: 10px;
    }
</style>

<div class="sv-portal">
    <div class="itp-shell">
        <div class="sv-shell">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="sv-title mb-0">Send Notification</h2>
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Notifications">Back to Notifications</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
                    @Model.Message
                </div>
            }

            <form method="post" class="mt-3">
                <!-- Select Students -->
                <div class="sv-form-group">
                    <label class="form-label">Select Students</label>
                    <p class="sv-muted mb-2">Choose one or more students to receive this notification:</p>
                    @if (Model.AssignedStudents.Count == 0)
                    {
                        <div class="alert alert-info">You have no assigned students.</div>
                    }
                    else
                    {
                        <div class="student-list">
                            @foreach (var student in Model.AssignedStudents)
                            {
                                <div class="student-item">
                                    <input type="checkbox" name="selectedStudentIds" value="@student.application_id" id="student_@student.application_id" />
                                    <label for="student_@student.application_id" class="mb-0 flex-grow-1" style="cursor: pointer;">
                                        <strong>@student.studentName</strong> (@student.studentID)
                                    </label>
                                </div>
                            }
                        </div>
                        <small class="sv-muted mt-2 d-block">
                            <input type="checkbox" id="selectAll" /> Select All
                        </small>
                    }
                </div>

                <!-- Notification Type -->
                <div class="sv-form-group">
                    <label for="type" class="form-label">Notification Type</label>
                    <select name="type" id="type" class="form-control" required>
                        <option value="">-- Select Type --</option>
                        <option value="system_alert">System Alert</option>
                        <option value="student_submission">Student Submission</option>
                        <option value="system_reminder">Reminder</option>
                        <option value="document_review">Document Review</option>
                        <option value="assignment_task">Assignment Task</option>
                        <option value="student_concern">Student Concern</option>
                        <option value="general_message">General Message</option>
                    </select>
                </div>

                <!-- Title -->
                <div class="sv-form-group">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="title" id="title" class="form-control" placeholder="Enter notification title" required maxlength="255" />
                </div>

                <!-- Message -->
                <div class="sv-form-group">
                    <label for="message" class="form-label">Message</label>
                    <textarea name="message" id="message" class="form-control" rows="5" placeholder="Enter notification message" required></textarea>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Send Notification</button>
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Supervisor/Notifications">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAllCheckbox = document.getElementById('selectAll');
        const studentCheckboxes = document.querySelectorAll('input[name="selectedStudentIds"]');

        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function() {
                studentCheckboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                });
            });

            // Update "Select All" state when individual checkboxes change
            studentCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const allChecked = Array.from(studentCheckboxes).every(cb => cb.checked);
                    const someChecked = Array.from(studentCheckboxes).some(cb => cb.checked);
                    selectAllCheckbox.checked = allChecked;
                    selectAllCheckbox.indeterminate = someChecked && !allChecked;
                });
            });
        }
    });
</script>
