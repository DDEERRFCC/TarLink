@page
@model StudentDashboardModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Student Dashboard";
    var studentName = HttpContext.Session.GetString("UserName") ?? "Student";
    var studentId = HttpContext.Session.GetString("StudentID") ?? "Not linked";
    var companyOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.CompanyOptions.Select(c => new { c.CompanyId, c.Name, c.Addresses }));
    var selectedCompanyName = Model.CompanyOptions
        .FirstOrDefault(c => c.CompanyId == Model.Input.CompanyId)?.Name ?? "";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --itp-bg-1: #f5efe4;
        --itp-bg-2: #edf4f4;
        --itp-bg-3: #f9fbfc;
        --itp-text: #182536;
        --itp-muted: #617082;
        --itp-primary: #0f7b6c;
        --itp-primary-dark: #0d5f63;
        --itp-accent: #d97706;
        --itp-accent-soft: #fff1d9;
        --itp-card: rgba(255, 255, 255, 0.86);
        --itp-border: rgba(24, 37, 54, 0.09);
        --itp-hero-start: #132238;
        --itp-hero-mid: #0f7b6c;
        --itp-hero-end: #d97706;
    }

    .student-portal {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, rgba(217, 119, 6, 0.18) 0%, transparent 25%),
            radial-gradient(circle at 88% 14%, rgba(15, 123, 108, 0.16) 0%, transparent 23%),
            linear-gradient(160deg, var(--itp-bg-1), var(--itp-bg-2) 52%, var(--itp-bg-3));
        padding: 2rem 0 2.5rem;
    }

    .itp-shell {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .itp-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(130deg, var(--itp-hero-start), var(--itp-hero-mid) 58%, var(--itp-hero-end));
        color: #fffdf7;
        border-radius: 28px;
        padding: 1.9rem;
        box-shadow: 0 22px 48px rgba(19, 34, 56, 0.18);
        animation: fade-up .5s ease-out;
    }

    .itp-hero::before,
    .itp-hero::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        opacity: .24;
        pointer-events: none;
    }

    .itp-hero::before {
        width: 240px;
        height: 240px;
        top: -80px;
        right: -60px;
        background: rgba(255, 255, 255, 0.16);
    }

    .itp-hero::after {
        width: 180px;
        height: 180px;
        left: -50px;
        bottom: -80px;
        background: rgba(255, 255, 255, 0.12);
    }

    .itp-hero-layout {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
        gap: 1.2rem;
        align-items: start;
    }

    .itp-hero-title {
        margin: .8rem 0 .45rem;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.6rem, 3.2vw, 2.5rem);
        line-height: 1.02;
        letter-spacing: -.03em;
    }

    .itp-hero-copy {
        max-width: 56ch;
        margin-bottom: 1.1rem;
        color: rgba(255, 253, 247, 0.88);
        line-height: 1.8;
    }

    .itp-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 1.15rem;
        margin-top: 1.15rem;
    }

    .itp-card {
        position: relative;
        overflow: hidden;
        background: var(--itp-card);
        border: 1px solid var(--itp-border);
        backdrop-filter: blur(10px);
        border-radius: 22px;
        padding: 1.1rem;
        box-shadow: 0 14px 30px rgba(26, 40, 60, 0.08);
        animation: fade-up .55s ease-out;
    }

    .itp-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 5px;
        background: linear-gradient(90deg, rgba(15, 123, 108, 0.95), rgba(217, 119, 6, 0.7));
        opacity: .9;
    }

    .itp-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: .6rem;
    }

    .itp-card-kicker {
        display: inline-flex;
        margin-bottom: .35rem;
        padding: .28rem .62rem;
        border-radius: 999px;
        background: rgba(15, 123, 108, .08);
        color: var(--itp-primary-dark);
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .itp-title {
        color: var(--itp-text);
        margin: 0 0 .1rem;
        font-size: 1.08rem;
        font-weight: 700;
    }

    .itp-muted {
        color: var(--itp-muted);
        margin: 0;
        font-size: .94rem;
    }

    .itp-pill {
        display: inline-block;
        padding: .42rem .78rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, .14);
        color: #fff7ec;
        font-weight: 600;
        font-size: .83rem;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .itp-progress-wrap {
        margin-top: .65rem;
        background: #dbe6e2;
        border-radius: 99px;
        height: 14px;
        overflow: hidden;
    }

    .itp-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--itp-primary), #19a38f, #ef9f28);
        border-radius: 99px;
    }

    .itp-summary-stack {
        display: grid;
        gap: .8rem;
        justify-items: end;
    }

    .itp-summary-chip {
        padding: .9rem 1rem;
        border-radius: 18px;
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .14);
        min-width: 180px;
        max-width: 220px;
    }

    .itp-summary-chip strong {
        display: block;
        margin-bottom: .2rem;
        font-size: .95rem;
    }

    .itp-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
        margin-top: .75rem;
    }

    .itp-action {
        text-decoration: none;
        background: linear-gradient(180deg, #f9fcfb, #eef7f5);
        border: 1px solid #d6e6e1;
        color: #13414a;
        border-radius: 14px;
        padding: .8rem .9rem;
        font-weight: 600;
        transition: all .2s ease;
    }

    .itp-action:hover {
        transform: translateY(-1px);
        border-color: #89cce8;
        color: #0d3344;
    }

    .itp-deadline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .72rem 0;
        border-bottom: 1px dashed #d6e2ef;
    }

    .itp-deadline:last-child {
        border-bottom: 0;
    }

    .itp-date {
        font-weight: 700;
        color: #92400e;
        background: #fff1d6;
        padding: .28rem .58rem;
        border-radius: 9px;
        font-size: .83rem;
    }

    .itp-date-overdue {
        color: #991b1b;
        background: #fee2e2;
    }

    .itp-deadline-overdue {
        border-bottom-color: #fecaca;
    }

    .itp-deadlines-scroll {
        margin-top: .35rem;
        max-height: 260px;
        overflow-y: auto;
        padding-right: .35rem;
    }

    .itp-deadlines-scroll::-webkit-scrollbar {
        width: 8px;
    }

    .itp-deadlines-scroll::-webkit-scrollbar-thumb {
        background: #c6d9ea;
        border-radius: 999px;
    }

    .itp-profile-btn {
        display: inline-block;
        margin-top: .9rem;
        text-decoration: none;
        background: linear-gradient(135deg, #e89d24, #f3b34f);
        color: #1f2937;
        font-weight: 700;
        padding: .65rem .95rem;
        border-radius: 12px;
        transition: all .2s ease;
        box-shadow: 0 12px 22px rgba(217, 119, 6, .2);
    }

    .itp-profile-btn:hover {
        transform: translateY(-1px);
        background: #fbbf24;
        color: #111827;
    }

    .itp-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .65rem;
    }

    .itp-meta-row {
        border: 1px solid #d6e2ef;
        background: #f8fbff;
        border-radius: 12px;
        padding: .65rem .7rem;
        display: flex;
        flex-direction: column;
        gap: .24rem;
        min-height: 72px;
    }

    .itp-meta-label {
        color: #5b6b7b;
        font-weight: 700;
        font-size: .78rem;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .itp-meta-value {
        color: #111827;
        font-weight: 600;
        font-size: .96rem;
        overflow-wrap: anywhere;
    }

    .itp-status-ok {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #86efac;
        display: inline-flex;
        align-self: flex-start;
        border-radius: 999px;
        padding: .16rem .5rem;
        font-size: .78rem;
        font-weight: 700;
    }

    .itp-status-pending {
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fcd34d;
        display: inline-flex;
        align-self: flex-start;
        border-radius: 999px;
        padding: .16rem .5rem;
        font-size: .78rem;
        font-weight: 700;
    }

    .itp-docs {
        grid-column: 1 / -1;
    }

    .itp-wide {
        grid-column: 1 / -1;
    }

    .itp-required-list {
        margin: .75rem 0 0;
        padding-left: 1.2rem;
        color: #1f2937;
    }

    .itp-required-list li {
        margin-bottom: .35rem;
        font-weight: 600;
    }

    .itp-doc-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: .8rem;
        margin-top: .75rem;
    }

    .itp-doc-separator {
        margin: 1rem 0 .5rem;
        border: 0;
        border-top: 1px solid #d6e2ef;
    }

    .itp-doc-item {
        border: 1px solid #d6e2ef;
        border-radius: 12px;
        padding: .75rem;
        background: #fbfdff;
    }

    .itp-doc-title {
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 .45rem;
        font-size: .95rem;
    }

    .itp-doc-actions {
        display: flex;
        gap: .45rem;
        flex-wrap: wrap;
    }

    .itp-doc-btn {
        text-decoration: none;
        font-size: .84rem;
        font-weight: 600;
        border-radius: 9px;
        padding: .35rem .6rem;
        border: 1px solid #c6d9ea;
        color: #0f3f54;
        background: #f2f8fd;
    }

    .itp-doc-btn:hover {
        background: #e3f1fb;
    }

    .itp-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
    }

    .itp-field {
        display: flex;
        flex-direction: column;
        gap: .32rem;
    }

    .itp-field-full {
        grid-column: 1 / -1;
    }

    .itp-label {
        font-size: .86rem;
        color: #334155;
        font-weight: 600;
    }

    .itp-help {
        font-size: .8rem;
        color: #64748b;
    }

    .itp-help-danger {
        color: #b91c1c;
        font-weight: 700;
    }

    .itp-input {
        border: 1px solid #cbd9e8;
        border-radius: 10px;
        padding: .5rem .65rem;
        font-size: .92rem;
        color: #0f172a;
        background: #fff;
    }

    .itp-input:focus {
        outline: none;
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, .15);
    }

    .itp-company-picker {
        position: relative;
        width: 100%;
    }

    .itp-company-picker .itp-input {
        width: 100%;
        box-sizing: border-box;
    }

    .itp-company-list {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #cbd9e8;
        border-radius: 10px;
        box-shadow: 0 10px 24px rgba(26, 40, 60, 0.12);
        max-height: 210px;
        overflow-y: auto;
        z-index: 10;
        display: none;
    }

    .itp-company-list.show {
        display: block;
    }

    .itp-company-item {
        padding: .5rem .65rem;
        cursor: pointer;
        font-size: .9rem;
        color: #0f172a;
        border-bottom: 1px solid #eef3f9;
    }

    .itp-company-item:last-child {
        border-bottom: 0;
    }

    .itp-company-item:hover {
        background: #f2f8fd;
    }

    .itp-company-empty {
        padding: .5rem .65rem;
        font-size: .86rem;
        color: #64748b;
    }

    .itp-note {
        margin-top: .75rem;
        padding: .65rem .75rem;
        border-radius: 10px;
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        font-size: .85rem;
    }

    .itp-note a {
        color: #b45309;
        font-weight: 700;
    }

    .itp-message-fab {
        position: fixed;
        right: 1.4rem;
        bottom: 1.4rem;
        width: 60px;
        height: 60px;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #0e7490, #14b8a6);
        color: #fff;
        box-shadow: 0 16px 34px rgba(14, 116, 144, 0.28);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 1080;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .itp-message-fab:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 36px rgba(14, 116, 144, 0.34);
    }

    .itp-bell-fab {
        position: fixed;
        right: 1.4rem;
        bottom: 6.1rem;
        width: 58px;
        height: 58px;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #d97706, #f2b34d);
        color: #fff;
        box-shadow: 0 16px 34px rgba(217, 119, 6, 0.28);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 1080;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .itp-bell-fab:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 36px rgba(217, 119, 6, 0.34);
    }

    .itp-message-badge {
        position: absolute;
        top: -3px;
        right: -1px;
        min-width: 22px;
        height: 22px;
        padding: 0 .35rem;
        border-radius: 999px;
        background: #ef4444;
        color: #fff;
        font-size: .73rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
    }

    .itp-bell-panel {
        position: fixed;
        right: 1.4rem;
        bottom: 10.4rem;
        width: min(390px, calc(100vw - 2rem));
        max-height: min(540px, calc(100vh - 12rem));
        background: #fff;
        border: 1px solid #d7e2ee;
        border-radius: 18px;
        box-shadow: 0 24px 54px rgba(15, 23, 42, 0.18);
        overflow: hidden;
        z-index: 1081;
        display: none;
        flex-direction: column;
    }

    .itp-bell-panel.show {
        display: flex;
        animation: fade-up .22s ease-out;
    }

    .itp-bell-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .8rem;
        padding: .95rem 1rem;
        background: linear-gradient(135deg, #fff6e7, #fffaf2);
        border-bottom: 1px solid #ecdcc3;
    }

    .itp-bell-close {
        border: 0;
        background: transparent;
        color: #7c5a1f;
        font-size: 1.3rem;
        line-height: 1;
    }

    .itp-bell-body {
        padding: .85rem;
        overflow-y: auto;
    }

    .itp-message-panel {
        position: fixed;
        right: 1.4rem;
        bottom: 5.8rem;
        width: min(380px, calc(100vw - 2rem));
        height: min(620px, calc(100vh - 7.5rem));
        background: #fff;
        border: 1px solid #d7e2ee;
        border-radius: 18px;
        box-shadow: 0 24px 54px rgba(15, 23, 42, 0.18);
        overflow: hidden;
        z-index: 1081;
        display: none;
        flex-direction: column;
    }

    .itp-message-panel.show {
        display: flex;
        animation: fade-up .22s ease-out;
    }

    .itp-message-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .8rem;
        padding: .95rem 1rem;
        background: linear-gradient(135deg, #f7fbff, #eef8fb);
        border-bottom: 1px solid #d7e2ee;
    }

    .itp-message-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #102a43;
    }

    .itp-message-close {
        border: 0;
        background: transparent;
        color: #526577;
        font-size: 1.3rem;
        line-height: 1;
    }

    .itp-message-list {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: .7rem;
        display: grid;
        align-content: start;
        gap: .6rem;
        overscroll-behavior: contain;
    }

    .itp-chat-bubble {
        border-radius: 16px;
        padding: .75rem .85rem;
        font-size: .88rem;
        line-height: 1.45;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .itp-chat-user {
        background: #e6f4fb;
        color: #0f3f54;
        justify-self: end;
        max-width: 88%;
    }

    .itp-chat-assistant {
        background: #f8fbff;
        border: 1px solid #d7e2ee;
        color: #334155;
        max-width: 100%;
    }

    .itp-chat-suggestions {
        flex: 0 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        padding: 0 .7rem .4rem;
        border-top: 1px solid #eef3f9;
        background: #fff;
    }

    .itp-chat-suggestion {
        border: 1px solid #cde6f4;
        background: #f6fbff;
        color: #0f5b78;
        border-radius: 999px;
        padding: .35rem .6rem;
        font-size: .78rem;
        font-weight: 600;
    }

    .itp-chat-compose {
        flex: 0 0 auto;
        border-top: 1px solid #d7e2ee;
        padding: .8rem;
        background: #fcfdff;
    }

    .itp-chat-input {
        width: 100%;
        min-height: 92px;
        resize: vertical;
        border: 1px solid #cbd9e8;
        border-radius: 12px;
        padding: .7rem .8rem;
        font-size: .9rem;
        color: #0f172a;
    }

    .itp-chat-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .8rem;
        margin-top: .65rem;
    }

    .itp-chat-hint {
        color: #64748b;
        font-size: .78rem;
    }

    .itp-chat-send {
        border: 0;
        border-radius: 10px;
        background: linear-gradient(90deg, #0e7490, #14b8a6);
        color: #fff;
        font-weight: 700;
        padding: .5rem .9rem;
    }

    .itp-chat-send:disabled {
        opacity: .65;
        cursor: wait;
    }

    .itp-announce-list {
        display: grid;
        gap: .55rem;
    }

    .itp-announce-item {
        border: 1px solid #d7e2ee;
        border-radius: 10px;
        background: #fbfdff;
    }

    .itp-announce-title {
        padding: .62rem .75rem;
        cursor: pointer;
        font-weight: 700;
        color: #1f2937;
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .itp-announce-title::-webkit-details-marker {
        display: none;
    }

    .itp-announce-message {
        padding: 0 .75rem .7rem;
        color: #475569;
        white-space: pre-wrap;
        max-height: 180px;
        overflow-y: auto;
    }

    .itp-announce-date {
        font-size: .78rem;
        color: #0f3f54;
        font-weight: 700;
        white-space: nowrap;
        background: #e6f4fb;
        border: 1px solid #b9deef;
        border-radius: 8px;
        padding: .16rem .45rem;
    }

    .itp-badge-ok, .itp-badge-missing {
        display: inline-block;
        font-size: .75rem;
        padding: .16rem .45rem;
        border-radius: 999px;
        margin-bottom: .45rem;
    }

    .itp-badge-ok {
        background: #dcfce7;
        color: #166534;
    }

    .itp-badge-missing {
        background: #fee2e2;
        color: #991b1b;
    }

    @@keyframes fade-up {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 900px) {
        .itp-hero-layout,
        .itp-grid {
            grid-template-columns: 1fr;
        }

        .itp-form-grid {
            grid-template-columns: 1fr;
        }

        .itp-meta-grid {
            grid-template-columns: 1fr;
        }

        .itp-actions {
            grid-template-columns: 1fr;
        }

        .itp-summary-stack {
            justify-items: start;
        }
    }

    @@media (max-width: 640px) {
        .itp-bell-fab,
        .itp-message-fab {
            right: 1rem;
        }

        .itp-message-fab {
            bottom: 1rem;
        }

        .itp-bell-fab {
            bottom: 5.7rem;
        }

        .itp-bell-panel,
        .itp-message-panel {
            right: 1rem;
            width: calc(100vw - 2rem);
        }

        .itp-message-panel {
            bottom: 5.4rem;
            height: min(70vh, calc(100vh - 6.6rem));
        }

        .itp-bell-panel {
            bottom: 10.1rem;
            max-height: min(52vh, calc(100vh - 11.5rem));
        }
    }
</style>

<div class="student-portal">
    <div class="itp-shell">
        <div class="itp-hero">
            <div class="itp-hero-layout">
                <div>
                    <div class="itp-pill">ITP Student Portal</div>
                    <h2 class="itp-hero-title">Welcome back, @studentName</h2>
                    <p class="itp-hero-copy">Track your internship progress, keep up with deadlines, manage company details, and stay on top of the documents you need for Industrial Training.</p>
                    <a asp-page="/Student/Profile" class="itp-profile-btn">Open My Profile</a>
                </div>

                <div class="itp-summary-stack">
                    <div class="itp-summary-chip">
                        <strong>Student ID</strong>
                        <span>@studentId</span>
                    </div>
                </div>
            </div>

        </div>

@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
        <div class="alert alert-success mt-3 mb-0">@successMessage</div>
}

        <div class="itp-grid">

            <section class="itp-card">
                <div class="itp-card-head">
                    <div>
                        <div class="itp-card-kicker">Status</div>
                        <h3 class="itp-title">Internship Status</h3>
                    </div>
                </div>
                <p class="itp-muted">@Model.InternshipStatusText</p>
                <div class="itp-progress-wrap">
                    <div class="itp-progress-bar" style="width:@Model.InternshipProgressPercent%;"></div>
                </div>
                <div class="d-flex justify-content-between mt-2">
                    <small class="itp-muted">Week @Model.InternshipCurrentWeek of @Model.InternshipTotalWeeks</small>
                    <small style="font-weight:700;color:#0e7490;">@Model.InternshipProgressPercent% Complete</small>
                </div>

                <div class="itp-actions">
                    <a class="itp-action" asp-page="/Student/UploadResume">Upload Resume / CV</a>
                    @if (string.Equals(Model.Status?.Trim(), "Approved", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="itp-action" asp-page="/Student/MyProgressReport">My Progress Report</a>
                    }
                </div>
            </section>

            <section class="itp-card">
                <div class="itp-card-head">
                    <div>
                        <div class="itp-card-kicker">Schedule</div>
                        <h3 class="itp-title">Upcoming Deadlines</h3>
                    </div>
                </div>
                @if (Model.ReportDeadlines.Count == 0)
                {
                    <p class="itp-muted mb-0">No report due dates configured for your cohort yet.</p>
                }
                else
                {
                    <div class="itp-deadlines-scroll">
                        @foreach (var deadline in Model.ReportDeadlines)
                        {
                            <div class="itp-deadline @(deadline.IsOverdue ? "itp-deadline-overdue" : string.Empty)">
                                <div>
                                    <div style="font-weight:600;color:#1f2937;">@deadline.Title</div>
                                    <small class="@(deadline.IsOverdue ? "text-danger" : "itp-muted")">@deadline.Note</small>
                                </div>
                                <span class="itp-date @(deadline.IsOverdue ? "itp-date-overdue" : string.Empty)">@deadline.Date.ToString("MMM dd")</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="itp-card itp-docs">
                <div class="itp-card-head">
                    <div>
                        <div class="itp-card-kicker">Overview</div>
                        <h3 class="itp-title">Internship Info</h3>
                    </div>
                </div>
                <div class="itp-meta-grid">
                    <div class="itp-meta-row">
                        <span class="itp-meta-label">Cohort</span>
                        <span class="itp-meta-value">@Model.Cohort</span>
                    </div>
                    <div class="itp-meta-row">
                        <span class="itp-meta-label">Intern Period</span>
                        <span class="itp-meta-value">@Model.InternPeriod</span>
                    </div>
                    <div class="itp-meta-row">
                        <span class="itp-meta-label">Status</span>
                        @if (string.Equals(Model.Status?.Trim(), "Approved", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="itp-status-ok">Approved</span>
                        }
                        else if (string.Equals(Model.Status?.Trim(), "Pending", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="itp-status-pending">Pending</span>
                        }
                        else
                        {
                            <span class="itp-meta-value">@Model.Status</span>
                        }
                    </div>
                    <div class="itp-meta-row">
                        <span class="itp-meta-label">Remark</span>
                        <span class="itp-meta-value">@Model.Remark</span>
                    </div>
                </div>
            </section>

            <section class="itp-card itp-docs">
                <div class="itp-card-head">
                    <div>
                        <div class="itp-card-kicker">Resources</div>
                        <h3 class="itp-title">My Documents</h3>
                    </div>
                </div>
                <p class="itp-muted">View and download all required ITP documents directly from your dashboard.</p>

                <div class="itp-doc-list">
                    @foreach (var doc in Model.Documents)
                    {
                        <article class="itp-doc-item">
                            @if (doc.Exists)
                            {
                                <span class="itp-badge-ok">Available</span>
                            }
                            else
                            {
                                <span class="itp-badge-missing">Missing File</span>
                            }

                            <h4 class="itp-doc-title">@doc.Title</h4>
                            <div class="itp-doc-actions">
                                @if (doc.CanView)
                                {
                                    <a class="itp-doc-btn" href="@doc.ViewPath" target="_blank" rel="noopener">View</a>
                                }
                                <a class="itp-doc-btn" href="@doc.DownloadPath">Download</a>
                            </div>
                        </article>
                    }
                </div>

                @if (Model.ApprovedStatusDocuments.Count > 0)
                {
                    <hr class="itp-doc-separator" />
                    <p class="itp-muted mb-0">The following documents are required to pass to your company supervisor during your first day of your internship.</p>
                    <div class="itp-doc-list">
                        @foreach (var doc in Model.ApprovedStatusDocuments)
                        {
                            <article class="itp-doc-item">
                                @if (doc.Exists)
                                {
                                    <span class="itp-badge-ok">Available</span>
                                }
                                else
                                {
                                    <span class="itp-badge-missing">Missing File</span>
                                }

                                <h4 class="itp-doc-title">@doc.Title</h4>
                                <div class="itp-doc-actions">
                                    @if (doc.CanView)
                                    {
                                        <a class="itp-doc-btn" href="@doc.ViewPath" target="_blank" rel="noopener">View</a>
                                    }
                                    <a class="itp-doc-btn" href="@doc.DownloadPath">Download</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="itp-card itp-wide">
                <div class="itp-card-head">
                    <div>
                        <div class="itp-card-kicker">Submission</div>
                        <h3 class="itp-title">Company Detail</h3>
                    </div>
                </div>
                <p class="itp-muted mb-3">Select a company first, then choose one of its available addresses.</p>

                <form method="post" asp-page-handler="SaveCompany" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="itp-form-grid">
                        <div class="itp-field itp-field-full">
                            <label class="itp-label" asp-for="Input.CompanyId">Company</label>
                            <div class="itp-company-picker">
                                <input class="itp-input" id="companyNameInput" value="@selectedCompanyName" placeholder="Type or select company name" autocomplete="off" />
                                <div id="companyListBox" class="itp-company-list"></div>
                            </div>
                            <input type="hidden" asp-for="Input.CompanyId" id="companyIdInput" />
                            <small class="itp-help">Type or choose from suggested company names.</small>
                        </div>

                        <div class="itp-field itp-field-full">
                            <label class="itp-label" asp-for="Input.Address">Address</label>
                            <select class="itp-input"
                                    asp-for="Input.Address"
                                    id="addressSelect"
                                    data-selected="@Model.Input.Address">
                                <option value="">-- Select Address --</option>
                            </select>
                            <small class="itp-help">Address options depend on the selected company.</small>
                            <div class="mt-2">
                                <a asp-page="/Student/OwnCompanyRequest">I wish to apply to a company of my own choice.</a>
                            </div>
                        </div>

                        <div class="itp-field">
                            <label class="itp-label" asp-for="Input.MonthlyAllowance">Monthly Allowance</label>
                            <input class="itp-input" asp-for="Input.MonthlyAllowance" type="number" min="0" step="0.01" />
                        </div>

                        <div class="itp-field">
                            <label class="itp-label" asp-for="Input.CompanySupervisorName">Com. Supervisor Name</label>
                            <input class="itp-input" asp-for="Input.CompanySupervisorName" />
                        </div>

                        <div class="itp-field itp-field-full">
                            <label class="itp-label" asp-for="Input.CompanySupervisorEmail">Com. Supervisor Email</label>
                            <input class="itp-input" asp-for="Input.CompanySupervisorEmail" type="email" />
                        </div>

                        <div class="itp-field">
                            <label class="itp-label" asp-for="Input.FormAcceptanceFile">Com. Acceptance Form</label>
                            <input class="itp-input" asp-for="Input.FormAcceptanceFile" type="file" data-file-preview="form-acceptance-preview" />
                            <small id="form-acceptance-preview" class="itp-help" data-default-size-text="Size: -">Size: -</small>
                            <small class="itp-help">Current: @Model.CurrentFormAcceptanceFile</small>
                        </div>

                        <div class="itp-field">
                            <label class="itp-label" asp-for="Input.FormAcknowledgementFile">Parent Ack. Form</label>
                            <input class="itp-input" asp-for="Input.FormAcknowledgementFile" type="file" data-file-preview="form-ack-preview" />
                            <small id="form-ack-preview" class="itp-help" data-default-size-text="Size: -">Size: -</small>
                            <small class="itp-help">Current: @Model.CurrentFormAcknowledgementFile</small>
                        </div>

                        <div class="itp-field">
                            <label class="itp-label" asp-for="Input.LetterOfIndemnityFile">Letter of Indemnity</label>
                            <input class="itp-input" asp-for="Input.LetterOfIndemnityFile" type="file" data-file-preview="letter-identity-preview" />
                            <small id="letter-identity-preview" class="itp-help" data-default-size-text="Size: -">Size: -</small>
                            <small class="itp-help">Current: @Model.CurrentLetterIdentityFile</small>
                        </div>

                        <div class="itp-field">
                            <label class="itp-label" asp-for="Input.HiredEvidenceFile">Hired evidence (if any)</label>
                            <input class="itp-input" asp-for="Input.HiredEvidenceFile" type="file" data-file-preview="other-evidence-preview" />
                            <small id="other-evidence-preview" class="itp-help" data-default-size-text="Size: -">Size: -</small>
                            <small class="itp-help">Current: @Model.CurrentOtherEvidenceFile</small>
                        </div>
                    </div>

                    <div class="itp-note">
                        Note: Please make sure your document is NOT more than 10MB.
                        <a href="https://www.ilovepdf.com/compress_pdf" target="_blank" rel="noopener">click here</a>
                        to do the compression if required.
                    </div>

                    <button type="submit" class="itp-profile-btn mt-2">Save Company Details</button>
                </form>
            </section>

        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section FloatingUi {
<button type="button" id="announcementBell" class="itp-bell-fab" aria-label="Open announcements" aria-expanded="false" aria-controls="announcementPanel">
    @if (Model.Announcements.Count > 0)
    {
        <span class="itp-message-badge">@Model.Announcements.Count</span>
    }
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 4.5a4 4 0 0 0-4 4v2.1c0 .7-.2 1.38-.58 1.97L6 14.5h12l-1.42-1.93A3.5 3.5 0 0 1 16 10.6V8.5a4 4 0 0 0-4-4Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10 17.5a2.2 2.2 0 0 0 4 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
</button>

<section id="announcementPanel" class="itp-bell-panel" aria-hidden="true">
    <div class="itp-bell-head">
        <div>
            <h3 class="itp-message-title">Announcements</h3>
            <p class="itp-muted mb-0">Important updates from the ITP committee.</p>
        </div>
        <button type="button" id="announcementPanelClose" class="itp-bell-close" aria-label="Close announcements">&times;</button>
    </div>
    <div class="itp-bell-body">
        @if (Model.Announcements.Count == 0)
        {
            <p class="mb-0" style="color:#64748b;">No announcements at the moment.</p>
        }
        else
        {
            <div class="itp-announce-list">
                @foreach (var item in Model.Announcements)
                {
                    <details class="itp-announce-item">
                        <summary class="itp-announce-title">
                            <span>@item.title</span>
                            <span class="itp-announce-date">@((item.publish_at ?? item.created_at).ToString("yyyy-MM-dd"))</span>
                        </summary>
                        <div class="itp-announce-message">@item.message</div>
                    </details>
                }
            </div>
        }
    </div>
</section>

}

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const antiforgeryTokenInput = document.querySelector("input[name='__RequestVerificationToken']");
        const announcementBell = document.getElementById("announcementBell");
        const announcementPanel = document.getElementById("announcementPanel");
        const announcementPanelClose = document.getElementById("announcementPanelClose");
        const companyOptions = @Html.Raw(companyOptionsJson);
        const companyNameInput = document.getElementById("companyNameInput");
        const companyIdInput = document.getElementById("companyIdInput");
        const companyListBox = document.getElementById("companyListBox");
        const addressSelect = document.getElementById("addressSelect");

        const setAnnouncementPanelState = (isOpen) => {
            if (!announcementBell || !announcementPanel) {
                return;
            }

            announcementPanel.classList.toggle("show", isOpen);
            announcementBell.setAttribute("aria-expanded", isOpen ? "true" : "false");
            announcementPanel.setAttribute("aria-hidden", isOpen ? "false" : "true");
        };

        if (announcementBell && announcementPanel) {
            announcementBell.addEventListener("click", () => {
                setAnnouncementPanelState(!announcementPanel.classList.contains("show"));
            });

            announcementPanelClose?.addEventListener("click", () => setAnnouncementPanelState(false));

            document.addEventListener("click", (event) => {
                if (!announcementPanel.classList.contains("show")) {
                    return;
                }

                const target = event.target;
                if (!announcementPanel.contains(target) && target !== announcementBell && !announcementBell.contains(target)) {
                    setAnnouncementPanelState(false);
                }
            });
        }

        if (!companyNameInput || !companyIdInput || !companyListBox || !addressSelect) {
            return;
        }

        const selectedAddress = addressSelect.getAttribute("data-selected") || "";

        const findCompanyByName = (name) => {
            const normalized = (name || "").trim().toLowerCase();
            if (!normalized) return null;
            return companyOptions.find(c => (c.name || c.Name || "").trim().toLowerCase() === normalized) || null;
        };

        const rebuildAddressOptions = (addresses, preferredAddress) => {
            addressSelect.innerHTML = "";

            const defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.textContent = "-- Select Address --";
            addressSelect.appendChild(defaultOption);

            for (const address of addresses) {
                const option = document.createElement("option");
                option.value = address;
                option.textContent = address;
                if (preferredAddress && preferredAddress === address) {
                    option.selected = true;
                }
                addressSelect.appendChild(option);
            }
        };

        const syncCompanySelection = (preferredAddress) => {
            const matched = findCompanyByName(companyNameInput.value);
            if (!matched) {
                companyIdInput.value = "";
                rebuildAddressOptions([], "");
                return;
            }

            companyIdInput.value = matched.companyId ?? matched.CompanyId;
            rebuildAddressOptions(matched.addresses ?? matched.Addresses ?? [], preferredAddress || "");
        };

        const renderCompanyList = () => {
            const query = (companyNameInput.value || "").trim().toLowerCase();
            const filtered = companyOptions.filter(c => {
                const name = (c.name || c.Name || "").toLowerCase();
                return query.length === 0 || name.includes(query);
            });

            companyListBox.innerHTML = "";
            if (filtered.length === 0) {
                const empty = document.createElement("div");
                empty.className = "itp-company-empty";
                empty.textContent = "No company found";
                companyListBox.appendChild(empty);
                return;
            }

            for (const c of filtered.slice(0, 80)) {
                const name = c.name || c.Name || "";
                const item = document.createElement("div");
                item.className = "itp-company-item";
                item.textContent = name;
                item.addEventListener("click", () => {
                    companyNameInput.value = name;
                    syncCompanySelection("");
                    companyListBox.classList.remove("show");
                });
                companyListBox.appendChild(item);
            }
        };

        syncCompanySelection(selectedAddress);
        companyNameInput.addEventListener("focus", () => {
            renderCompanyList();
            companyListBox.classList.add("show");
        });
        companyNameInput.addEventListener("input", () => {
            syncCompanySelection("");
            renderCompanyList();
            companyListBox.classList.add("show");
        });
        companyNameInput.addEventListener("change", () => syncCompanySelection(""));
        document.addEventListener("click", (event) => {
            if (!companyListBox.contains(event.target) && event.target !== companyNameInput) {
                companyListBox.classList.remove("show");
            }
        });

        const formatFileSize = (bytes) => {
            if (bytes < 1024) return `${bytes} B`;
            if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(2).replace(/\.?0+$/, "")} KB`;
            return `${(bytes / (1024 * 1024)).toFixed(2).replace(/\.?0+$/, "")} MB`;
        };
        const maxUploadBytes = 10 * 1024 * 1024;

        document.querySelectorAll("input[type='file'][data-file-preview]").forEach((input) => {
            const previewId = input.getAttribute("data-file-preview");
            const preview = previewId ? document.getElementById(previewId) : null;
            if (!preview) {
                return;
            }

            input.addEventListener("change", () => {
                const file = input.files && input.files.length > 0 ? input.files[0] : null;
                if (!file) {
                    preview.textContent = preview.getAttribute("data-default-size-text") || "Size: -";
                    preview.classList.remove("itp-help-danger");
                    return;
                }

                preview.textContent = `Size: ${formatFileSize(file.size)}`;
                preview.classList.toggle("itp-help-danger", file.size > maxUploadBytes);
            });
        });
    });
</script>
