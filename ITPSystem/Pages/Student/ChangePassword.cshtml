@page
@model StudentChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --pw-bg-1: #f5efe4;
        --pw-bg-2: #edf4f4;
        --pw-bg-3: #fafcfd;
        --pw-text: #182536;
        --pw-muted: #647285;
        --pw-card: rgba(255, 255, 255, 0.9);
        --pw-border: rgba(24, 37, 54, 0.08);
        --pw-primary: #0f7b6c;
        --pw-primary-dark: #0d5f63;
    }

    .pw-wrap {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        background:
            radial-gradient(circle at 10% 8%, rgba(217, 119, 6, 0.16), transparent 24%),
            radial-gradient(circle at 88% 16%, rgba(15, 123, 108, 0.16), transparent 24%),
            linear-gradient(165deg, var(--pw-bg-1), var(--pw-bg-2) 55%, var(--pw-bg-3));
        min-height: calc(100vh - 80px);
        padding: 1.8rem 0 2.6rem;
    }

    .pw-shell {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .pw-card {
        border: 1px solid var(--pw-border);
        border-radius: 24px;
        background: var(--pw-card);
        box-shadow: 0 14px 30px rgba(20, 40, 70, 0.08);
        padding: 1.4rem;
    }

    .pw-kicker {
        display: inline-flex;
        margin-bottom: .55rem;
        padding: .28rem .62rem;
        border-radius: 999px;
        background: rgba(15, 123, 108, .08);
        color: var(--pw-primary-dark);
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .pw-title {
        margin: 0 0 .25rem;
        color: var(--pw-text);
        font-size: 1.6rem;
        font-weight: 700;
    }

    .pw-copy {
        margin: 0 0 1rem;
        color: var(--pw-muted);
        line-height: 1.7;
    }

    .pw-grid {
        display: grid;
        gap: .9rem;
    }

    .pw-field {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .pw-label {
        font-size: .86rem;
        color: #334155;
        font-weight: 700;
    }

    .pw-input {
        border: 1px solid #cfdcdf;
        border-radius: 14px;
        padding: .8rem .9rem;
        background: #fff;
        color: #0f172a;
    }

    .pw-input:focus {
        outline: none;
        border-color: var(--pw-primary);
        box-shadow: 0 0 0 0.2rem rgba(15, 123, 108, 0.14);
    }

    .pw-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
    }

    .pw-save,
    .pw-back {
        border-radius: 14px;
        padding: .82rem 1rem;
        font-weight: 700;
        text-decoration: none;
    }

    .pw-save {
        border: 0;
        color: #fff;
        background: linear-gradient(135deg, var(--pw-primary), #19a38f);
        box-shadow: 0 14px 24px rgba(15, 123, 108, .18);
    }

    .pw-back {
        border: 1px solid #d7e2ee;
        background: #f8fbff;
        color: #1f2937;
    }
</style>

<div class="pw-wrap">
    <div class="pw-shell">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-info">@Model.StatusMessage</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var entry in ViewData.ModelState.Values)
                    {
                        foreach (var error in entry.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        }

        <section class="pw-card">
            <div class="pw-kicker">Security</div>
            <h1 class="pw-title">Change Password</h1>
            <p class="pw-copy">Enter your current password, then choose a new password for your student account.</p>

            <form method="post">
                <div class="pw-grid">
                    <div class="pw-field">
                        <label asp-for="Input.CurrentPassword" class="pw-label">Current Password</label>
                        <input asp-for="Input.CurrentPassword" type="password" class="form-control pw-input" />
                        <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="pw-field">
                        <label asp-for="Input.NewPassword" class="pw-label">New Password</label>
                        <input asp-for="Input.NewPassword" type="password" class="form-control pw-input" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="pw-field">
                        <label asp-for="Input.ConfirmPassword" class="pw-label">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control pw-input" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="pw-actions">
                    <button type="submit" class="pw-save">Update Password</button>
                    <a asp-page="/Student/Profile" class="pw-back">Back to Profile</a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
