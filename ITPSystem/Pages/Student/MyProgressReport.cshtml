@page
@model StudentMyProgressReportModel
@{
    ViewData["Title"] = "My Progress Report";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
        --mpr-bg-1: #eef4fb;
        --mpr-bg-2: #dfeaf6;
        --mpr-text: #0f172a;
        --mpr-muted: #516175;
        --mpr-border: #cfdeee;
        --mpr-card: #ffffff;
        --mpr-primary: #0f766e;
        --mpr-primary-dark: #115e59;
        --mpr-accent: #f59e0b;
    }

    .mpr-page {
        font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at 8% 8%, #d7f0ff 0%, transparent 26%),
            radial-gradient(circle at 90% 14%, #ffecc7 0%, transparent 24%),
            linear-gradient(160deg, var(--mpr-bg-1), var(--mpr-bg-2));
        padding: 1.5rem 0 2rem;
    }

    .mpr-shell {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .mpr-hero {
        background: linear-gradient(125deg, #0f172a, #134e4a 70%, #0ea5a1);
        color: #fff;
        border-radius: 18px;
        padding: 1.2rem 1.25rem;
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.18);
    }

    .mpr-pill {
        display: inline-block;
        background: rgba(255, 255, 255, .18);
        border: 1px solid rgba(255, 255, 255, .28);
        border-radius: 999px;
        padding: .22rem .62rem;
        font-size: .78rem;
        font-weight: 700;
        margin-bottom: .35rem;
    }

    .mpr-back-btn {
        text-decoration: none;
        background: #f8fafc;
        color: #0f172a;
        border: 1px solid #dbe4ef;
        border-radius: 10px;
        padding: .45rem .72rem;
        font-weight: 700;
    }

    .mpr-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .mpr-card {
        background: var(--mpr-card);
        border: 1px solid var(--mpr-border);
        border-radius: 14px;
        box-shadow: 0 10px 22px rgba(21, 32, 54, 0.08);
    }

    .mpr-section-divider {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: .9rem;
        margin: .15rem 0 -.1rem;
    }

    .mpr-section-divider::before,
    .mpr-section-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, #bfd3e4, transparent);
    }

    .mpr-section-title {
        margin: 0;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #496579;
        white-space: nowrap;
    }

    .mpr-card-head {
        padding: .95rem 1rem .3rem;
    }

    .mpr-card-title {
        margin: 0;
        color: var(--mpr-text);
        font-size: 1.02rem;
        font-weight: 700;
    }

    .mpr-card-sub {
        margin: .2rem 0 0;
        color: var(--mpr-muted);
        font-size: .9rem;
    }

    .mpr-card-body {
        padding: .8rem 1rem 1rem;
    }

    .mpr-meta {
        display: grid;
        gap: .55rem;
        margin-bottom: .9rem;
    }

    .mpr-meta-item {
        border: 1px solid #d9e5f1;
        border-radius: 10px;
        background: #f8fbff;
        padding: .55rem .7rem;
    }

    .mpr-meta-label {
        display: block;
        font-size: .74rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: .15rem;
    }

    .mpr-meta-value {
        color: var(--mpr-text);
        font-size: .92rem;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .mpr-label {
        font-size: .86rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: .25rem;
    }

    .mpr-input {
        border: 1px solid #c9d9e8;
        border-radius: 10px;
        padding: .55rem .65rem;
        font-size: .92rem;
    }

    .mpr-input:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, .15);
    }

    .mpr-submit-btn {
        width: 100%;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(90deg, var(--mpr-primary), #0ea5a1);
        color: #fff;
        font-weight: 700;
        padding: .5rem .9rem;
    }

    .mpr-status {
        display: inline-block;
        border-radius: 999px;
        padding: .15rem .52rem;
        font-size: .78rem;
        font-weight: 700;
    }

    .mpr-status-pending {
        background: #e2e8f0;
        color: #334155;
    }

    .mpr-status-submitted {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .mpr-status-approved {
        background: #dcfce7;
        color: #166534;
    }

    .mpr-status-rejected {
        background: #fee2e2;
        color: #b91c1c;
    }

    @@media (max-width: 900px) {
        .mpr-hero {
            padding: 1rem;
        }
    }
</style>

<div class="mpr-page">
    <div class="mpr-shell">
        <section class="mpr-hero">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div>
                    <div class="mpr-pill">Student Portal</div>
                    <h2 class="mb-1">My Progress Report</h2>
                    <p class="mb-0" style="opacity:.9;">Submit Progress Report 1-6 and Final Report with due dates.</p>
                </div>
                <a asp-page="/Student/Dashboard" class="mpr-back-btn">Back to Dashboard</a>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success mt-3 mb-0">@Model.StatusMessage</div>
        }

        <div class="mpr-grid">
            @foreach (var item in Model.ReportTypes)
            {
                if (string.Equals(item.Key, "P1", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="mpr-section-divider">
                        <p class="mpr-section-title">Progress Reports</p>
                    </div>
                }

                if (string.Equals(item.Key, "F", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="mpr-section-divider">
                        <p class="mpr-section-title">Final Report</p>
                    </div>
                }

                var existingReport = Model.GetReportForKey(item.Key);
                var statusText = Model.GetDisplayStatus(existingReport, item.DueDate);
                var statusClass = statusText switch
                {
                    "Submitted" => "mpr-status mpr-status-submitted",
                    "Submitted Late" => "mpr-status mpr-status-rejected",
                    "Approved" => "mpr-status mpr-status-approved",
                    "Missing" => "mpr-status mpr-status-rejected",
                    "Rejected" => "mpr-status mpr-status-rejected",
                    _ => "mpr-status mpr-status-pending"
                };
                var dueText = item.DueDate?.ToString("yyyy-MM-dd") ?? "TBA";
                var updatedText = existingReport?.updated_at.ToString("yyyy-MM-dd HH:mm") ?? "-";
                var buttonText = existingReport == null ? "Submit Report" : "Replace Report";

                <section class="mpr-card">
                    <div class="mpr-card-head">
                        <h3 class="mpr-card-title">@item.Label</h3>
                        <p class="mpr-card-sub">Upload this report in its own submission box.</p>
                    </div>
                    <div class="mpr-card-body">
                        <div class="mpr-meta">
                            <div class="mpr-meta-item">
                                <span class="mpr-meta-label">Due Date</span>
                                <span class="mpr-meta-value">@dueText</span>
                            </div>
                            <div class="mpr-meta-item">
                                <span class="mpr-meta-label">Status</span>
                                <span class="@statusClass">@statusText</span>
                            </div>
                            <div class="mpr-meta-item">
                                <span class="mpr-meta-label">Last Update</span>
                                <span class="mpr-meta-value">@updatedText</span>
                            </div>
                            <div class="mpr-meta-item">
                                <span class="mpr-meta-label">Current File</span>
                                <span class="mpr-meta-value">
                                    @if (!string.IsNullOrWhiteSpace(existingReport?.file_path))
                                    {
                                        <a href="@existingReport.file_path" target="_blank" rel="noopener">View File</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No file uploaded</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <form method="post" asp-page-handler="Submit" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <input type="hidden" asp-for="Input.ReportKey" value="@item.Key" />

                            <div class="mb-3">
                                <label asp-for="Input.ReportFile" class="mpr-label">Attach File</label>
                                <input asp-for="Input.ReportFile" type="file" class="form-control mpr-input" />
                                <div class="form-text">Allowed: .pdf, .doc, .docx (max 10MB)</div>
                                <span asp-validation-for="Input.ReportFile" class="text-danger"></span>
                            </div>

                            <button type="submit" class="mpr-submit-btn">@buttonText</button>
                        </form>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
