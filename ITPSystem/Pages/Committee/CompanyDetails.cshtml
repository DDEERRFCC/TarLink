@page
@model CommitteeCompanyDetailsModel
@{
    ViewData["CommitteePageTitle"] = "Company Details";
}

<style>
    .company-details-page {
        display: grid;
        gap: 1rem;
        max-width: 1280px;
        margin: 0 auto;
    }

    .company-details-banner {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 1.35rem;
        color: #fff;
        background: linear-gradient(135deg, #132238, #8f2d56 58%, #b34873);
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.14);
    }

    .company-details-banner::after {
        content: "";
        position: absolute;
        right: -42px;
        top: -50px;
        width: 180px;
        height: 180px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
    }

    .company-details-banner > * {
        position: relative;
        z-index: 1;
    }

    .company-details-banner-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 1rem;
    }

    .company-details-kicker {
        display: inline-flex;
        align-items: center;
        padding: .34rem .72rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .company-details-title {
        margin: .55rem 0 .35rem;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        font-family: Georgia, "Times New Roman", serif;
    }

    .company-details-copy {
        margin: 0;
        max-width: 70ch;
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.75;
    }

    .company-details-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        text-decoration: none;
        border-radius: 999px;
        padding: .78rem 1rem;
        border: 1px solid #e6cdd7;
        background: linear-gradient(180deg, #ffffff, #f5fbff);
        color: #4f3041;
        font-weight: 700;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

    .company-details-back-btn:hover {
        color: #6b2847;
        border-color: #d7a7ba;
        box-shadow: 0 14px 26px rgba(15, 23, 42, 0.09);
        transform: translateY(-1px);
    }

    .company-details-back-btn::before {
        content: "<";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 999px;
        background: #f6dfe9;
        color: #7b264b;
        font-size: .9rem;
        line-height: 1;
    }

    .company-details-meta-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .9rem;
    }

    .company-details-meta-card,
    .company-details-form-card,
    .company-details-danger-card {
        border: 1px solid #eadce2;
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff, #fff9fb);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
    }

    .company-details-meta-card {
        position: relative;
        overflow: hidden;
        padding: 1rem 1.05rem;
    }

    .company-details-meta-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 5px;
        background: linear-gradient(90deg, #8f2d56, #b34873);
    }

    .company-details-meta-label {
        color: #7a6673;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .company-details-meta-value {
        margin-top: .4rem;
        color: #2f1724;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .company-details-meta-note {
        margin-top: .3rem;
        color: #917d89;
        font-size: .84rem;
    }

    .company-details-form-card,
    .company-details-danger-card {
        padding: 1rem;
    }

    .company-details-section-title {
        margin: 0;
        color: #132238;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .company-details-section-copy {
        margin: .35rem 0 0;
        color: #7a6673;
        line-height: 1.7;
        font-size: .92rem;
    }

    .company-details-field-group {
        border: 1px solid #e5eef7;
        border-radius: 18px;
        padding: 1rem;
        background: #fff9fb;
        margin-top: 1rem;
    }

    .company-details-field-group-title {
        margin: 0 0 .85rem;
        color: #1f3a54;
        font-size: .95rem;
        font-weight: 700;
    }

    .company-details-form-card .form-label {
        color: #36506a;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .company-details-form-card .form-control,
    .company-details-form-card .form-select {
        min-height: 44px;
        border-radius: 14px;
        border-color: #d1ddea;
        box-shadow: none;
    }

    .company-details-form-card .form-control:focus,
    .company-details-form-card .form-select:focus {
        border-color: #b34873;
        box-shadow: 0 0 0 .2rem rgba(20, 184, 166, 0.14);
    }

    .company-details-upload-note {
        margin-top: .35rem;
        color: #6f8295;
        font-size: .8rem;
    }

    .company-details-location-note {
        margin: .2rem 0 0;
        color: #7a6673;
        font-size: .88rem;
        line-height: 1.65;
    }

    .company-details-address-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .85rem;
    }

    .company-details-address-fields .company-details-field-wide {
        grid-column: 1 / -1;
    }

    .company-details-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
    }

    .company-details-save-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: .85rem 1rem;
        border: none;
        border-radius: 14px;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(90deg, #8f2d56, #b34873);
    }

    .company-details-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: .85rem 1rem;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        color: #35516a;
        background: #fff;
        border: 1px solid #dcc9d2;
    }

    .company-details-danger-card {
        border-color: #fecdd3;
        background: linear-gradient(180deg, #fff8f9, #ffffff);
    }

    .company-details-danger-copy {
        margin: .35rem 0 1rem;
        color: #7f1d1d;
        line-height: 1.7;
        font-size: .92rem;
    }

    .company-details-delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: .85rem 1rem;
        border: 1px solid #ef4444;
        border-radius: 14px;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(90deg, #dc2626, #ef4444);
    }

    @@media (max-width: 1199.98px) {
        .company-details-meta-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .company-details-meta-grid {
            grid-template-columns: 1fr;
        }

        .company-details-banner-top,
        .company-details-action-row {
            flex-direction: column;
        }

        .company-details-back-btn,
        .company-details-save-btn,
        .company-details-cancel-btn,
        .company-details-delete-btn {
            width: 100%;
        }

        .company-details-address-fields {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="committee-page">
    <div class="company-details-page">
        <section class="company-details-banner">
            <div class="company-details-banner-top">
                <div>
                    <div class="company-details-kicker">Company Details</div>
                    <h3 class="company-details-title">Update company records with clearer structure and context.</h3>
                    <p class="company-details-copy">Review identity, locations, publication settings, and company metadata from one editing workspace before saving changes back to the company directory.</p>
                </div>
                <a href="/Committee/Companies" class="company-details-back-btn">Back to Company List</a>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success mb-0">@Model.StatusMessage</div>
        }

        <section class="company-details-meta-grid">
            <article class="company-details-meta-card">
                <div class="company-details-meta-label">Company ID</div>
                <div class="company-details-meta-value">@Model.Input.company_id</div>
                <div class="company-details-meta-note">System record identifier.</div>
            </article>
            <article class="company-details-meta-card">
                <div class="company-details-meta-label">Created</div>
                <div class="company-details-meta-value">@Model.CreatedAt.ToString("yyyy-MM-dd")</div>
                <div class="company-details-meta-note">@Model.CreatedAt.ToString("HH:mm")</div>
            </article>
            <article class="company-details-meta-card">
                <div class="company-details-meta-label">Last Update</div>
                <div class="company-details-meta-value">@Model.LastUpdatedAt.ToString("yyyy-MM-dd")</div>
                <div class="company-details-meta-note">@Model.LastUpdatedAt.ToString("HH:mm")</div>
            </article>
            <article class="company-details-meta-card">
                <div class="company-details-meta-label">Assets</div>
                <div class="company-details-meta-value">@((Model.HasLogo ? 1 : 0) + (Model.HasSsmCert ? 1 : 0)) file(s)</div>
                <div class="company-details-meta-note">Logo: @(Model.HasLogo ? "Yes" : "No"), SSM: @(Model.HasSsmCert ? "Yes" : "No")</div>
            </article>
        </section>

        <section class="company-details-form-card">
            <h3 class="company-details-section-title">Edit Company Record</h3>
            <p class="company-details-section-copy">Update the company profile, office locations, business details, and visibility settings below.</p>

            <form method="post" asp-page-handler="Save" enctype="multipart/form-data">
                <input type="hidden" asp-for="Input.company_id" />
                <input type="hidden" asp-for="Input.branch_id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>

                <div class="company-details-field-group">
                    <h4 class="company-details-field-group-title">Core Information</h4>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label asp-for="Input.name" class="form-label">Company Name</label>
                            <input asp-for="Input.name" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.regNo" class="form-label">Registration No</label>
                            <input asp-for="Input.regNo" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Input.vacancyLevel" class="form-label">Vacancy Level</label>
                            <select asp-for="Input.vacancyLevel" class="form-select">
                                <option value="">-- Select --</option>
                                <option value="Diploma">Diploma</option>
                                <option value="Degree">Degree</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Input.totalNoOfStaff" class="form-label">Total Staff</label>
                            <input asp-for="Input.totalNoOfStaff" type="number" min="0" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="company-details-field-group">
                    <h4 class="company-details-field-group-title">Company Addresses</h4>
                    <p class="company-details-location-note">You are editing only the selected branch from Company Management. This address can store its own street line, city, state, postcode, and country.</p>
                    <div class="company-details-address-fields">
                        <div class="company-details-field-wide">
                            <label asp-for="Input.address1" class="form-label">Address Line</label>
                            <input asp-for="Input.address1" class="form-control" placeholder="Street, building, or office location" />
                        </div>
                        <div>
                            <label asp-for="Input.address1City" class="form-label">City</label>
                            <input asp-for="Input.address1City" class="form-control" />
                        </div>
                        <div>
                            <label asp-for="Input.address1State" class="form-label">State</label>
                            <input asp-for="Input.address1State" class="form-control" />
                        </div>
                        <div>
                            <label asp-for="Input.address1Postcode" class="form-label">Postcode</label>
                            <input asp-for="Input.address1Postcode" class="form-control" />
                        </div>
                        <div>
                            <label asp-for="Input.address1Country" class="form-label">Country</label>
                            <input asp-for="Input.address1Country" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="company-details-field-group">
                    <h4 class="company-details-field-group-title">Business & Contact Details</h4>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="Input.lastVisit" class="form-label">Last Visit</label>
                            <input asp-for="Input.lastVisit" type="date" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.lastContact" class="form-label">Last Contact</label>
                            <input asp-for="Input.lastContact" type="date" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.industryInvolved" class="form-label">Industry</label>
                            <input asp-for="Input.industryInvolved" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.productsAndServices" class="form-label">Products & Services</label>
                            <input asp-for="Input.productsAndServices" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.companyBackground" class="form-label">Company Background</label>
                            <input asp-for="Input.companyBackground" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.website" class="form-label">Website</label>
                            <input asp-for="Input.website" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.remark" class="form-label">Remark</label>
                            <input asp-for="Input.remark" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="company-details-field-group">
                    <h4 class="company-details-field-group-title">Visibility & Files</h4>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="Input.status" class="form-label">Status</label>
                            <select asp-for="Input.status" class="form-select">
                                <option value="0">Pending</option>
                                <option value="1">Active</option>
                                <option value="2">Inactive</option>
                                <option value="3">Suspended</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.visibility" class="form-label">Visibility</label>
                            <select asp-for="Input.visibility" class="form-select">
                                <option value="1">Visible</option>
                                <option value="0">Hidden</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.logoFile" class="form-label">Logo</label>
                            <input asp-for="Input.logoFile" type="file" class="form-control" />
                            <div class="company-details-upload-note">Current: @(Model.HasLogo ? "Uploaded" : "None")</div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.ssmCertFile" class="form-label">SSM Certificate</label>
                            <input asp-for="Input.ssmCertFile" type="file" class="form-control" />
                            <div class="company-details-upload-note">Current: @(Model.HasSsmCert ? "Uploaded" : "None")</div>
                        </div>
                    </div>
                </div>

                <div class="company-details-action-row">
                    <button type="submit" class="company-details-save-btn">Save Changes</button>
                    <a href="/Committee/Companies" class="company-details-cancel-btn">Cancel</a>
                </div>
            </form>
        </section>

        <section class="company-details-danger-card">
            <h3 class="company-details-section-title">Danger Zone</h3>
            <p class="company-details-danger-copy">Deleting this company removes the record from the company directory. This action cannot be undone.</p>

            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this company record?');">
                <input type="hidden" name="companyId" value="@Model.Input.company_id" />
                <button type="submit" class="company-details-delete-btn">Delete Company</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

