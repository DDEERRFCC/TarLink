@page
@model CommitteeSendNotificationModel
@{
    ViewData["CommitteePageTitle"] = "Send Notification";
}

<style>
    .send-notify-page { display: grid; gap: 1rem; max-width: 1280px; margin: 0 auto; }
    .send-notify-banner, .send-notify-card { border: 1px solid #eadce2; border-radius: 20px; background: linear-gradient(180deg, #ffffff, #fff9fb); box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06); }
    .send-notify-banner { position: relative; overflow: hidden; padding: 1.35rem; border-radius: 24px; color: #fff; background: linear-gradient(135deg, #132238, #8f2d56 58%, #b34873); box-shadow: 0 18px 36px rgba(15, 23, 42, 0.14); }
    .send-notify-banner::after { content: ""; position: absolute; right: -42px; top: -50px; width: 180px; height: 180px; border-radius: 999px; background: rgba(255, 255, 255, 0.12); }
    .send-notify-banner > * { position: relative; z-index: 1; }
    .send-notify-top { display: flex; justify-content: space-between; align-items: start; gap: 1rem; }
    .send-notify-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: .34rem .72rem; background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .22); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .send-notify-back { display: inline-flex; align-items: center; gap: .55rem; text-decoration: none; border-radius: 999px; padding: .78rem 1rem; border: 1px solid #e6cdd7; background: linear-gradient(180deg, #ffffff, #f5fbff); color: #4f3041; font-weight: 700; box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06); }
    .send-notify-back::before { content: "<"; display: inline-flex; align-items: center; justify-content: center; width: 1.7rem; height: 1.7rem; border-radius: 999px; background: #f6dfe9; color: #7b264b; font-size: .9rem; line-height: 1; }
    .send-notify-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
    .send-notify-secondary-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 140px; padding: .82rem 1rem; border-radius: 14px; text-decoration: none; font-weight: 700; color: #fff; background: transparent; border: 1px solid rgba(255, 255, 255, 0.32); }
    .send-notify-card { padding: 1rem; }
    .send-notify-card h4 { margin: 0; color: #2f1724; font-size: 1.08rem; font-weight: 700; }
    .send-notify-card p { margin: .25rem 0 0; color: #917d89; line-height: 1.65; }
    .send-notify-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
    .send-notify-form .full { grid-column: 1 / -1; }
    .send-notify-form .form-label { font-size: .82rem; font-weight: 700; color: #7a6673; text-transform: uppercase; letter-spacing: .05em; }
    .send-notify-form .form-control, .send-notify-form .form-select { min-height: 46px; border-radius: 14px; border-color: #ddcbd4; }
    .send-notify-form textarea.form-control { min-height: 140px; }
    .send-notify-form-actions { display: flex; justify-content: flex-end; gap: .75rem; margin-top: 1rem; }
    .send-notify-form-actions .btn { min-width: 150px; border-radius: 14px; font-weight: 700; }
    @@media (max-width: 991.98px) { .send-notify-form { grid-template-columns: 1fr; } .send-notify-top, .send-notify-actions, .send-notify-form-actions { flex-direction: column; align-items: stretch; } .send-notify-back, .send-notify-secondary-btn, .send-notify-form-actions .btn { width: 100%; } }
</style>

<div class="committee-page">
    <div class="send-notify-page">
        <section class="send-notify-banner">
            <div class="send-notify-top">
                <div class="send-notify-pill">Notification Portal</div>
                <a href="/Committee/Notifications" class="send-notify-back">Back to Notifications</a>
            </div>
            <h3 class="mt-3 mb-2">Send a notification from its own page.</h3>
            <p>Choose who should receive the message, then narrow the audience with academic filters when needed.</p>
            <div class="send-notify-actions">
                <a asp-page="/Committee/Notifications" class="send-notify-secondary-btn">Delivery History</a>
            </div>
        </section>

        <section class="send-notify-card">
            <h4>Send Notification</h4>
            <p>Set the target audience, review the filters, and deliver the message to matching users.</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
                <div class="send-notify-form">
                    <div>
                        <label asp-for="Input.TargetRole" class="form-label">Target Role</label>
                        <select asp-for="Input.TargetRole" class="form-select">
                            <option value="student">Student</option>
                            <option value="supervisor">Supervisor</option>
                            <option value="committee">Committee</option>
                            <option value="all">All</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Type" class="form-label">Type</label>
                        <input asp-for="Input.Type" class="form-control" placeholder="committee, reminder, report, review" />
                        <span asp-validation-for="Input.Type" class="text-danger"></span>
                    </div>
                    <div class="full">
                        <label asp-for="Input.Title" class="form-label">Title</label>
                        <input asp-for="Input.Title" class="form-control" />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Input.CohortId" class="form-label">Cohort</label>
                        <select asp-for="Input.CohortId" class="form-select">
                            <option value="">All cohorts</option>
                            @foreach (var cohort in Model.Cohorts)
                            {
                                <option value="@cohort.cohort_id">@cohort.description</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.StudentStatus" class="form-label">Student Status</label>
                        <select asp-for="Input.StudentStatus" class="form-select">
                            <option value="">All statuses</option>
                            <option value="pending">Pending</option>
                            <option value="approved">Approved</option>
                            <option value="rejected">Rejected</option>
                            <option value="withdrawn">Withdrawn</option>
                            <option value="none">None</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Faculty" class="form-label">Faculty</label>
                        <select asp-for="Input.Faculty" class="form-select">
                            <option value="">All faculties</option>
                            @foreach (var faculty in Model.Faculties)
                            {
                                <option value="@faculty">@faculty</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Campus" class="form-label">Campus</label>
                        <select asp-for="Input.Campus" class="form-select">
                            <option value="">All campuses</option>
                            @foreach (var campus in Model.Campuses)
                            {
                                <option value="@campus">@campus</option>
                            }
                        </select>
                    </div>
                    <div class="full">
                        <label asp-for="Input.Message" class="form-label">Message</label>
                        <textarea asp-for="Input.Message" class="form-control"></textarea>
                        <span asp-validation-for="Input.Message" class="text-danger"></span>
                    </div>
                </div>
                <div class="send-notify-form-actions">
                    <a href="/Committee/Notifications" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Send Notification</button>
                </div>
            </form>
        </section>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
