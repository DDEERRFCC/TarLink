@page
@model CommitteeImportStudentsModel
@{
    ViewData["CommitteePageTitle"] = "Import Student";
}

<style>
    .import-student-page {
        display: grid;
        gap: 1rem;
        max-width: 1280px;
        margin: 0 auto;
    }

    .import-student-banner {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 1.35rem;
        color: #fff;
        background: linear-gradient(135deg, #132238, #8f2d56 58%, #b34873);
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.14);
    }

    .import-student-banner::after {
        content: "";
        position: absolute;
        right: -42px;
        top: -50px;
        width: 180px;
        height: 180px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
    }

    .import-student-banner > * {
        position: relative;
        z-index: 1;
    }

    .import-student-banner-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 1rem;
    }

    .import-student-kicker {
        display: inline-flex;
        align-items: center;
        padding: .34rem .72rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .import-student-title {
        margin: .55rem 0 .35rem;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        font-family: Georgia, "Times New Roman", serif;
    }

    .import-student-copy {
        margin: 0;
        max-width: 72ch;
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.75;
    }

    .import-student-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        text-decoration: none;
        border-radius: 999px;
        padding: .78rem 1rem;
        border: 1px solid #e6cdd7;
        background: linear-gradient(180deg, #ffffff, #f5fbff);
        color: #4f3041;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

    .import-student-back-btn:hover {
        color: #6b2847;
        border-color: #d7a7ba;
        box-shadow: 0 14px 26px rgba(15, 23, 42, 0.09);
        transform: translateY(-1px);
    }

    .import-student-back-btn::before {
        content: "<";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 999px;
        background: #f6dfe9;
        color: #7b264b;
        font-size: .9rem;
        line-height: 1;
    }

    .import-student-banner-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
    }

    .import-student-banner-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .8rem 1rem;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        color: #fff;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.32);
    }

    .import-student-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(320px, .88fr);
        gap: 1rem;
        align-items: start;
    }

    .import-student-card,
    .import-student-note-card,
    .import-student-error-card {
        border: 1px solid #eadce2;
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff, #fff9fb);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
    }

    .import-student-card,
    .import-student-note-card {
        padding: 1rem;
    }

    .import-student-section-title {
        margin: 0;
        color: #132238;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .import-student-section-copy {
        margin: .35rem 0 0;
        color: #7a6673;
        line-height: 1.7;
        font-size: .92rem;
    }

    .import-student-upload-box {
        margin-top: 1rem;
        border: 1px dashed #9fd8cf;
        border-radius: 18px;
        background: linear-gradient(180deg, #f8fffd, #ffffff);
        padding: 1rem;
    }

    .import-student-upload-box label {
        display: block;
        margin-bottom: .45rem;
        color: #36506a;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .import-student-upload-box .form-control {
        min-height: 48px;
        border-radius: 14px;
        border-color: #d1ddea;
        box-shadow: none;
    }

    .import-student-upload-box .form-control:focus {
        border-color: #b34873;
        box-shadow: 0 0 0 .2rem rgba(20, 184, 166, 0.14);
    }

    .import-student-upload-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .8rem;
        margin-top: 1rem;
        align-items: center;
    }

    .import-student-submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 150px;
        min-height: 46px;
        padding: .8rem 1rem;
        border: none;
        border-radius: 14px;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(90deg, #8f2d56, #b34873);
    }

    .import-student-hint {
        color: #7a6673;
        font-size: .9rem;
    }

    .import-student-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-top: 1rem;
    }

    .import-student-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 14px;
        padding: .42rem .82rem;
        background: linear-gradient(180deg, #dbeafe, #eff6ff);
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        font-size: .8rem;
        font-weight: 700;
        box-shadow: 0 8px 18px rgba(29, 78, 216, 0.08);
    }

    .import-student-note-list {
        margin: 1rem 0 0;
        padding-left: 1.1rem;
        color: #7a6673;
    }

    .import-student-note-list li {
        margin-bottom: .45rem;
        line-height: 1.65;
    }

    .import-student-error-card {
        overflow: hidden;
    }

    .import-student-error-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1rem 0;
    }

    .import-student-error-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .4rem .78rem;
        background: #fdecef;
        color: #9f305d;
        font-size: .84rem;
        font-weight: 700;
    }

    .import-student-error-table {
        margin: 1rem 0 0;
    }

    .import-student-error-table thead th {
        border-bottom-width: 1px;
        background: #faf1f5;
        color: #7a6673;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    @@media (max-width: 991.98px) {
        .import-student-grid {
            grid-template-columns: 1fr;
        }

        .import-student-banner-top,
        .import-student-banner-actions,
        .import-student-upload-actions {
            flex-direction: column;
        }

        .import-student-back-btn,
        .import-student-banner-link,
        .import-student-submit-btn {
            width: 100%;
        }
    }
</style>

<div class="committee-page">
    <div class="import-student-page">
        <section class="import-student-banner">
            <div class="import-student-banner-top">
                <div>
                    <div class="import-student-kicker">Import Student</div>
                    <h3 class="import-student-title">Bring student records into the portal with a cleaner intake flow.</h3>
                    <p class="import-student-copy">Upload an Excel or CSV file, validate the required columns, and import student records directly into the student application system with clearer feedback on anything that needs fixing.</p>
                </div>
                <a href="/Committee/Dashboard" class="import-student-back-btn">Back to Dashboard</a>
            </div>
            <div class="import-student-banner-actions">
                <a asp-page="/Committee/Students" class="import-student-banner-link">Back to Student List</a>
                <a asp-page="/Committee/UnregisteredStudents" class="import-student-banner-link">Open Unregistered Student</a>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-info mb-0">@Model.Message</div>
        }

        <section class="import-student-grid">
            <div class="import-student-card">
                <h3 class="import-student-section-title">Upload Student Sheet</h3>
                <p class="import-student-section-copy">Choose a prepared `.xlsx` or `.csv` file and import student records into `studentapplication` together with the related account setup.</p>

                <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="import-student-upload-box">
                    <label asp-for="UploadFile">Student File</label>
                    <input asp-for="UploadFile" type="file" class="form-control" accept=".xlsx,.csv" />

                    <div class="import-student-upload-actions">
                        <button type="submit" class="import-student-submit-btn">Import Students</button>
                        <div class="import-student-hint">Accepted file types: `.xlsx`, `.csv`</div>
                    </div>
                </form>
            </div>

            <aside class="import-student-note-card">
                <h3 class="import-student-section-title">File Format Guide</h3>
                <p class="import-student-section-copy">Use these required columns so the import can map the file correctly.</p>

                <div class="import-student-chip-row">
                    <span class="import-student-chip">number_ic</span>
                    <span class="import-student-chip">studentID</span>
                    <span class="import-student-chip">studentName</span>
                    <span class="import-student-chip">studentEmail</span>
                    <span class="import-student-chip">cohortId</span>
                    <span class="import-student-chip">level</span>
                    <span class="import-student-chip">programme</span>
                    <span class="import-student-chip">groupNo</span>
                </div>

                <ul class="import-student-note-list">
                    <li>Optional columns supported: `applyStatus`, `ucSupervisor`, `ucSupervisorEmail`, `ucSupervisorContact`.</li>
                    <li>Rows are rejected when student ID, email, IC number, cohort, or person ID rules fail validation.</li>
                    <li>Imported records are written into `studentapplication`, then linked to `person` and `sysuser`.</li>
                </ul>
            </aside>
        </section>

        @if (Model.Errors.Any())
        {
            <section class="import-student-error-card">
                <div class="import-student-error-head">
                    <div>
                        <h3 class="import-student-section-title">Import Errors</h3>
                        <p class="import-student-section-copy">Review the failed rows below, fix the source file, and import again.</p>
                    </div>
                    <div class="import-student-error-pill">@Model.Errors.Count issue(s)</div>
                </div>

                <div class="table-responsive import-student-error-table">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 120px;">Row</th>
                                <th>Error</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var err in Model.Errors)
                            {
                                <tr>
                                    <td>@err.RowNo</td>
                                    <td>@err.Error</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
</div>

