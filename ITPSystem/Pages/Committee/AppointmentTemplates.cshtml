@page
@model CommitteeAppointmentTemplatesModel
@{
    ViewData["CommitteePageTitle"] = "Template Upload";
    var totalTemplates = Model.Templates.Count;
    var cohortCount = Model.Templates.Select(x => x.Template.cohort_id).Distinct().Count();
    var withFilesCount = Model.Templates.Count(x =>
        !string.IsNullOrWhiteSpace(x.Template.company_acceptance_letter_path) ||
        !string.IsNullOrWhiteSpace(x.Template.indemnity_letter_path) ||
        !string.IsNullOrWhiteSpace(x.Template.parent_acknowledgement_form_path) ||
        !string.IsNullOrWhiteSpace(x.Template.company_supervisor_evaluation_form_path) ||
        !string.IsNullOrWhiteSpace(x.Template.progress_report_template_path) ||
        !string.IsNullOrWhiteSpace(x.Template.final_report_template_path) ||
        !string.IsNullOrWhiteSpace(x.Template.student_support_letter_path) ||
        !string.IsNullOrWhiteSpace(x.Template.appointment_confirmation_letter_path) ||
        !string.IsNullOrWhiteSpace(x.Template.warning_letter_path));
}

<style>
    .tpl-page { display:grid; gap:1rem; max-width:1280px; margin:0 auto; }
    .tpl-banner { position:relative; overflow:hidden; border-radius:24px; padding:1.35rem; color:#fff; background:linear-gradient(135deg,#132238,#8f2d56 58%,#b34873); box-shadow:0 18px 36px rgba(15,23,42,.14); }
    .tpl-banner::after { content:""; position:absolute; right:-42px; top:-50px; width:180px; height:180px; border-radius:999px; background:rgba(255,255,255,.12); }
    .tpl-banner > * { position:relative; z-index:1; }
    .tpl-top { display:flex; justify-content:space-between; align-items:start; gap:1rem; }
    .tpl-kicker { display:inline-flex; padding:.34rem .72rem; border-radius:999px; background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22); font-size:.78rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    .tpl-title { margin:.55rem 0 .35rem; font-size:clamp(1.55rem,3vw,2.2rem); font-family:Georgia,"Times New Roman",serif; }
    .tpl-copy { margin:0; max-width:72ch; color:rgba(255,255,255,.88); line-height:1.75; }
    .tpl-back { display:inline-flex; align-items:center; gap:.55rem; text-decoration:none; border-radius:999px; padding:.78rem 1rem; border:1px solid #e6cdd7; background:linear-gradient(180deg,#fff,#f5fbff); color:#4f3041; font-weight:700; white-space:nowrap; box-shadow:0 10px 22px rgba(15,23,42,.06); }
    .tpl-back::before { content:"<"; display:inline-flex; align-items:center; justify-content:center; width:1.7rem; height:1.7rem; border-radius:999px; background:#f6dfe9; color:#7b264b; font-size:.9rem; }
    .tpl-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.85rem; margin-top:1rem; }
    .tpl-stat { border-radius:18px; padding:.95rem 1rem; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.18); }
    .tpl-stat-label { font-size:.78rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:rgba(255,255,255,.72); }
    .tpl-stat-value { margin-top:.3rem; font-size:1.5rem; font-weight:700; }
    .tpl-card { border:1px solid #eadce2; border-radius:22px; background:linear-gradient(180deg,#fff,#fff9fb); box-shadow:0 12px 26px rgba(15,23,42,.06); padding:1rem; }
    .tpl-section-title { margin:0; color:#132238; font-size:1.05rem; font-weight:700; }
    .tpl-section-copy { margin:.35rem 0 0; color:#7a6673; line-height:1.7; font-size:.92rem; }
    .tpl-link { color:#8f2d56; font-weight:700; text-decoration:underline; word-break:break-all; }
    .tpl-actions { display:flex; flex-wrap:wrap; gap:.8rem; align-items:center; }
    .tpl-btn, .tpl-btn-lite, .tpl-btn-danger { display:inline-flex; align-items:center; justify-content:center; min-height:46px; padding:.8rem 1rem; border-radius:14px; text-decoration:none; font-weight:700; }
    .tpl-btn { min-width:170px; border:none; color:#fff; background:linear-gradient(90deg,#8f2d56,#b34873); }
    .tpl-btn-lite { border:1px solid #dcc9d2; background:#fff; color:#35516a; }
    .tpl-btn-danger { border:1px solid #fecaca; background:#fdecef; color:#9f305d; }
    .tpl-list { display:grid; gap:.9rem; }
    .tpl-list-card { border:1px solid #eadce2; border-radius:18px; background:#fff; padding:1rem; box-shadow:0 10px 22px rgba(15,23,42,.05); }
    .tpl-list-top { display:flex; justify-content:space-between; align-items:start; gap:1rem; }
    .tpl-list-title { margin:0; font-size:1.05rem; font-weight:700; color:#132238; }
    .tpl-meta { margin-top:.35rem; color:#7a6673; font-size:.92rem; }
    .tpl-files-toggle {
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-width:140px;
        min-height:42px;
        padding:.65rem .9rem;
        border-radius:12px;
        border:1px solid #dcc9d2;
        background:#fff;
        color:#35516a;
        font-weight:700;
        cursor:pointer;
        list-style:none;
    }
    .tpl-files-toggle::-webkit-details-marker { display:none; }
    .tpl-files-toggle::after {
        content:"Show Letters";
    }
    details[open] .tpl-files-toggle::after {
        content:"Hide Letters";
    }
    .tpl-files-panel {
        margin-top:1rem;
    }
    .tpl-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.9rem; margin-top:1rem; }
    .tpl-link-item { padding:.8rem .9rem; border-radius:14px; background:#fdf6f9; border:1px solid #dbe8f3; }
    .tpl-link-label { color:#7a6673; font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; }
    .tpl-link-value { margin-top:.35rem; }
    .tpl-link-size { margin-top:.35rem; color:#7a6673; font-size:.82rem; }
    .tpl-content { margin-top:1rem; border:1px solid #dbe8f3; border-radius:16px; background:#fdf6f9; padding:.95rem 1rem; color:#35516a; white-space:pre-wrap; }
    .tpl-empty { border:1px dashed #dcc9d2; border-radius:18px; padding:1.3rem; text-align:center; color:#7a6673; background:linear-gradient(180deg,#fff9fb,#fff); }
    @@media (max-width: 991.98px) {
        .tpl-links, .tpl-stats { grid-template-columns:1fr; }
        .tpl-top, .tpl-list-top, .tpl-actions { flex-direction:column; align-items:stretch; }
        .tpl-back, .tpl-btn, .tpl-btn-lite, .tpl-btn-danger { width:100%; }
    }
</style>

<div class="committee-page">
    <div class="tpl-page">
        <section class="tpl-banner">
            <div class="tpl-top">
                <div>
                    <div class="tpl-kicker">Template Upload</div>
                    <h3 class="tpl-title">Manage appointment letters and reporting templates by cohort.</h3>
                    <p class="tpl-copy">Review saved template bundles, open uploaded files, and jump into a dedicated page whenever you need to add or edit a template set.</p>
                </div>
                <a href="/Committee/Dashboard" class="tpl-back">Back to Dashboard</a>
            </div>
            <div class="tpl-stats">
                <div class="tpl-stat"><div class="tpl-stat-label">Template Sets</div><div class="tpl-stat-value">@totalTemplates</div></div>
                <div class="tpl-stat"><div class="tpl-stat-label">Cohorts Covered</div><div class="tpl-stat-value">@cohortCount</div></div>
                <div class="tpl-stat"><div class="tpl-stat-label">Sets With Files</div><div class="tpl-stat-value">@withFilesCount</div></div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-info mb-0">@Model.StatusMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-0">@Model.ErrorMessage</div>
        }

        <section class="tpl-card">
            <h3 class="tpl-section-title">Template Workspace</h3>
            <p class="tpl-section-copy">Create a new template bundle or update an existing one from a dedicated page so the document workflow stays cleaner.</p>
            <div class="tpl-actions mt-3">
                <a asp-page="/Committee/AppointmentTemplateForm" class="tpl-btn">Add New Template</a>
            </div>
        </section>

        <section class="tpl-card">
            <h3 class="tpl-section-title">Saved Template Sets</h3>
            <p class="tpl-section-copy">Review current template records, open uploaded files, or edit a saved set when the cohort documents need a refresh.</p>

            @if (Model.Templates.Count == 0)
            {
                <div class="tpl-empty">No template set has been uploaded yet.</div>
            }
            else
            {
                <div class="tpl-list">
                    @foreach (var item in Model.Templates)
                    {
                        <article class="tpl-list-card">
                            <div class="tpl-list-top">
                                <div>
                                    <h4 class="tpl-list-title">@item.Template.template_name</h4>
                                    <div class="tpl-meta">@item.CohortLabel</div>
                                    <div class="tpl-meta">Created @item.Template.created_at.ToString("dd MMM yyyy HH:mm")</div>
                                </div>
                                <div class="tpl-actions">
                                    <a asp-page="/Committee/AppointmentTemplateForm" asp-route-editId="@item.Template.template_id" class="tpl-btn-lite">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Template.template_id" onsubmit="return confirm('Delete this template set?');">
                                        <button type="submit" class="tpl-btn-danger">Delete</button>
                                    </form>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Template.content))
                            {
                                <div class="tpl-content">@item.Template.content</div>
                            }

                            <details class="tpl-files-panel">
                                <summary class="tpl-files-toggle"></summary>
                                <div class="tpl-links">
                                <div class="tpl-link-item"><div class="tpl-link-label">Company Acceptance Letter</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.company_acceptance_letter_path)) { <a class="tpl-link" href="@item.Template.company_acceptance_letter_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.company_acceptance_letter_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Indemnity Letter</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.indemnity_letter_path)) { <a class="tpl-link" href="@item.Template.indemnity_letter_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.indemnity_letter_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Parent Acknowledgement Form</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.parent_acknowledgement_form_path)) { <a class="tpl-link" href="@item.Template.parent_acknowledgement_form_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.parent_acknowledgement_form_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Company Supervisor Evaluation Form</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.company_supervisor_evaluation_form_path)) { <a class="tpl-link" href="@item.Template.company_supervisor_evaluation_form_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.company_supervisor_evaluation_form_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Progress Report Template</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.progress_report_template_path)) { <a class="tpl-link" href="@item.Template.progress_report_template_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.progress_report_template_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Final Report Template</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.final_report_template_path)) { <a class="tpl-link" href="@item.Template.final_report_template_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.final_report_template_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Student Support Letter</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.student_support_letter_path)) { <a class="tpl-link" href="@item.Template.student_support_letter_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.student_support_letter_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Appointment Confirmation Letter</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.appointment_confirmation_letter_path)) { <a class="tpl-link" href="@item.Template.appointment_confirmation_letter_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.appointment_confirmation_letter_path)</div> } else { <span>-</span> }</div></div>
                                <div class="tpl-link-item"><div class="tpl-link-label">Warning Letter</div><div class="tpl-link-value">@if (!string.IsNullOrWhiteSpace(item.Template.warning_letter_path)) { <a class="tpl-link" href="@item.Template.warning_letter_path" target="_blank">Open file</a><div class="tpl-link-size">Size: @Model.GetFileSizeLabel(item.Template.warning_letter_path)</div> } else { <span>-</span> }</div></div>
                            </div>
                            </details>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>
