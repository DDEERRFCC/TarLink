@page
@model CommitteeNotificationsModel
@{
    ViewData["CommitteePageTitle"] = "Notifications";
}

<style>
    .committee-notify-stack { display: grid; gap: 1rem; max-width: 1280px; margin: 0 auto; }
    .committee-notify-banner, .committee-notify-card, .committee-notify-stat { border: 1px solid #eadce2; border-radius: 20px; background: linear-gradient(180deg, #ffffff, #fff9fb); box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06); }
    .committee-notify-banner { position: relative; overflow: hidden; padding: 1.35rem; border-radius: 24px; color: #fff; background: linear-gradient(135deg, #102133, #176b87 55%, #4fa59d); box-shadow: 0 18px 36px rgba(15, 23, 42, 0.14); }
    .committee-notify-banner::after { content: ""; position: absolute; right: -42px; top: -50px; width: 180px; height: 180px; border-radius: 999px; background: rgba(255, 255, 255, 0.12); }
    .committee-notify-banner > * { position: relative; z-index: 1; }
    .committee-notify-top { display: flex; justify-content: space-between; align-items: start; gap: 1rem; }
    .committee-notify-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: .34rem .72rem; background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .22); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .committee-notify-back { display: inline-flex; align-items: center; gap: .55rem; text-decoration: none; border-radius: 999px; padding: .78rem 1rem; border: 1px solid rgba(255, 255, 255, .28); background: rgba(255, 255, 255, .12); color: #fff; font-weight: 700; }
    .committee-notify-back:hover { color: #fff; background: rgba(255, 255, 255, .18); }
    .committee-notify-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
    .committee-notify-stat { position: relative; overflow: hidden; padding: 1rem 1.05rem; }
    .committee-notify-stat::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; background: linear-gradient(90deg, #176b87, #4fa59d); }
    .committee-notify-label { color: #5f7280; font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .committee-notify-value { margin-top: .35rem; color: #143247; font-size: 1.75rem; font-weight: 700; line-height: 1.1; }
    .committee-notify-note { margin-top: .3rem; color: #71808c; font-size: .88rem; }
    .committee-notify-card { padding: 1rem; }
    .committee-notify-card h4 { margin: 0; color: #143247; font-size: 1.08rem; font-weight: 700; }
    .committee-notify-card p { margin: .25rem 0 0; color: #71808c; line-height: 1.65; }
    .committee-notify-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
    .committee-notify-form .full { grid-column: 1 / -1; }
    .committee-notify-form .form-label { font-size: .82rem; font-weight: 700; color: #5f7280; text-transform: uppercase; letter-spacing: .05em; }
    .committee-notify-form .form-control, .committee-notify-form .form-select { min-height: 46px; border-radius: 14px; border-color: #cfe1ea; }
    .committee-notify-form textarea.form-control { min-height: 140px; }
    .committee-notify-actions { display: flex; justify-content: flex-end; margin-top: 1rem; }
    .committee-notify-actions .btn { min-width: 150px; border-radius: 14px; font-weight: 700; }
    .committee-notify-table thead th { background: #eef8fa; color: #5f7280; font-size: .8rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }
    .committee-read { display: inline-flex; border-radius: 999px; padding: .28rem .65rem; font-size: .78rem; font-weight: 700; }
    .committee-read.is-read { background: #d1fae5; color: #065f46; }
    .committee-read.is-unread { background: #fee2e2; color: #991b1b; }
    @@media (max-width: 991.98px) { .committee-notify-grid, .committee-notify-form { grid-template-columns: 1fr; } .committee-notify-top, .committee-notify-actions { flex-direction: column; align-items: stretch; } .committee-notify-back, .committee-notify-actions .btn { width: 100%; } }
</style>

<div class="committee-page">
    <div class="committee-notify-stack">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success mb-0">@Model.StatusMessage</div>
        }

        <section class="committee-notify-banner">
            <div class="committee-notify-top">
                <div class="committee-notify-pill">Notification Portal</div>
                <a asp-page="/Committee/Dashboard" class="committee-notify-back">Back to Dashboard</a>
            </div>
            <h3 class="mt-3 mb-2">Send internal notifications to the right portal users.</h3>
            <p>Broadcast updates to students, supervisors, or committee members and keep a visible delivery history inside the system.</p>
        </section>

        <section class="committee-notify-grid">
            <article class="committee-notify-stat"><div class="committee-notify-label">Total Sent</div><div class="committee-notify-value">@Model.TotalNotifications</div><div class="committee-notify-note">All notification records stored in the portal.</div></article>
            <article class="committee-notify-stat"><div class="committee-notify-label">Unread</div><div class="committee-notify-value">@Model.UnreadNotifications</div><div class="committee-notify-note">Still unread by recipients.</div></article>
            <article class="committee-notify-stat"><div class="committee-notify-label">Student Users</div><div class="committee-notify-value">@Model.StudentRecipients</div><div class="committee-notify-note">Active student accounts available for targeting.</div></article>
            <article class="committee-notify-stat"><div class="committee-notify-label">Supervisor Users</div><div class="committee-notify-value">@Model.SupervisorRecipients</div><div class="committee-notify-note">Active supervisor accounts available for targeting.</div></article>
        </section>

        <section class="committee-notify-card">
            <h4>Send Notification</h4>
            <p>Choose who should receive the message, then narrow the audience with academic filters when needed.</p>

            <form method="post" asp-page-handler="Send">
                <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
                <div class="committee-notify-form">
                    <div>
                        <label asp-for="Input.TargetRole" class="form-label">Target Role</label>
                        <select asp-for="Input.TargetRole" class="form-select">
                            <option value="student">Student</option>
                            <option value="supervisor">Supervisor</option>
                            <option value="committee">Committee</option>
                            <option value="all">All</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Type" class="form-label">Type</label>
                        <input asp-for="Input.Type" class="form-control" placeholder="committee, reminder, report, review" />
                        <span asp-validation-for="Input.Type" class="text-danger"></span>
                    </div>
                    <div class="full">
                        <label asp-for="Input.Title" class="form-label">Title</label>
                        <input asp-for="Input.Title" class="form-control" />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Input.CohortId" class="form-label">Cohort</label>
                        <select asp-for="Input.CohortId" class="form-select">
                            <option value="">All cohorts</option>
                            @foreach (var cohort in Model.Cohorts)
                            {
                                <option value="@cohort.cohort_id">@cohort.description</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.StudentStatus" class="form-label">Student Status</label>
                        <select asp-for="Input.StudentStatus" class="form-select">
                            <option value="">All statuses</option>
                            <option value="pending">Pending</option>
                            <option value="approved">Approved</option>
                            <option value="rejected">Rejected</option>
                            <option value="withdrawn">Withdrawn</option>
                            <option value="none">None</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Faculty" class="form-label">Faculty</label>
                        <select asp-for="Input.Faculty" class="form-select">
                            <option value="">All faculties</option>
                            @foreach (var faculty in Model.Faculties)
                            {
                                <option value="@faculty">@faculty</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Campus" class="form-label">Campus</label>
                        <select asp-for="Input.Campus" class="form-select">
                            <option value="">All campuses</option>
                            @foreach (var campus in Model.Campuses)
                            {
                                <option value="@campus">@campus</option>
                            }
                        </select>
                    </div>
                    <div class="full">
                        <label asp-for="Input.Message" class="form-label">Message</label>
                        <textarea asp-for="Input.Message" class="form-control"></textarea>
                        <span asp-validation-for="Input.Message" class="text-danger"></span>
                    </div>
                </div>
                <div class="committee-notify-actions">
                    <button type="submit" class="btn btn-primary">Send Notification</button>
                </div>
            </form>
        </section>

        <section class="committee-notify-card">
            <h4>Recent Delivery History</h4>
            <p>The latest notification records show who received the message, what type it was, and whether it has been read.</p>
            <div class="table-responsive mt-3">
                <table class="table align-middle committee-notify-table mb-0">
                    <thead>
                        <tr><th>Date</th><th>Recipient</th><th>Type</th><th>Title</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentNotifications.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No notifications have been sent yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model.RecentNotifications)
                            {
                                <tr>
                                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><div class="fw-semibold text-dark">@item.ToUser</div><div class="text-muted small text-uppercase">@item.ToRole</div></td>
                                    <td>@item.Type</td>
                                    <td><div class="fw-semibold text-dark">@item.Title</div><div class="text-muted small">@item.Message</div></td>
                                    <td><span class="committee-read @(item.IsRead ? "is-read" : "is-unread")">@(item.IsRead ? "Read" : "Unread")</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
