@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string NavClass(string pagePath) =>
        string.Equals(currentPage, pagePath, StringComparison.OrdinalIgnoreCase)
            ? "committee-nav-link active"
            : "committee-nav-link";
}

<style>
    .committee-nav-wrap {
        margin: 0 0 1rem;
        border: 1px solid #d8e5f1;
        border-radius: 18px;
        background: linear-gradient(180deg, #f8fbff, #fdfefe);
        padding: .9rem;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
    }

    .committee-nav-title {
        font-size: .95rem;
        font-weight: 700;
        color: #44576d;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 .7rem;
    }

    .committee-nav-sections {
        display: grid;
        gap: .9rem;
    }

    .committee-nav-section {
        border: 1px solid #e1ebf4;
        border-radius: 14px;
        background: rgba(255, 255, 255, .85);
        padding: .7rem;
    }

    .committee-nav-section-title {
        margin: 0 0 .55rem;
        color: #607284;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .committee-nav-list {
        display: grid;
        gap: .45rem;
    }

    .committee-nav-link {
        display: block;
        text-decoration: none;
        font-size: .95rem;
        font-weight: 700;
        color: #0f3f54;
        border: 1px solid #d6e5f1;
        background: #fff;
        border-radius: 12px;
        padding: .62rem .8rem;
        transition: all .15s ease;
    }

    .committee-nav-link:hover {
        border-color: #9fcae4;
        background: #eef7ff;
        color: #0b2f40;
        transform: translateX(2px);
    }

    .committee-nav-link.active {
        background: linear-gradient(90deg, #0f766e, #0ea5a1);
        border-color: #0f766e;
        color: #fff;
    }
</style>

<div class="committee-nav-wrap">
    <p class="committee-nav-title mb-0">Committee Modules</p>
    <div class="committee-nav-sections mt-3">
        <section class="committee-nav-section">
            <p class="committee-nav-section-title">Overview</p>
            <div class="committee-nav-list">
                <a class="@NavClass("/Committee/Dashboard")" asp-page="/Committee/Dashboard">Dashboard</a>
                <a class="@NavClass("/Committee/SummaryReports")" asp-page="/Committee/SummaryReports">Summary Reports</a>
            </div>
        </section>

        <section class="committee-nav-section">
            <p class="committee-nav-section-title">Student Management</p>
            <div class="committee-nav-list">
                <a class="@NavClass("/Committee/Students")" asp-page="/Committee/Students">Student List</a>
                <a class="@NavClass("/Committee/StudentResumes")" asp-page="/Committee/StudentResumes">Student Resume/CV</a>
                <a class="@NavClass("/Committee/ImportStudents")" asp-page="/Committee/ImportStudents">Import Student</a>
                <a class="@NavClass("/Committee/UnregisteredStudents")" asp-page="/Committee/UnregisteredStudents">Unregistered Student</a>
            </div>
        </section>

        <section class="committee-nav-section">
            <p class="committee-nav-section-title">Academic & Evaluation</p>
            <div class="committee-nav-list">
                <a class="@NavClass("/Committee/Cohorts")" asp-page="/Committee/Cohorts">Cohort</a>
                <a class="@NavClass("/Committee/AppointmentTemplates")" asp-page="/Committee/AppointmentTemplates">Template Upload</a>
                <a class="@NavClass("/Committee/ProgressEvaluation")" asp-page="/Committee/ProgressEvaluation">Progress & Evaluation</a>
            </div>
        </section>

        <section class="committee-nav-section">
            <p class="committee-nav-section-title">Company Management</p>
            <div class="committee-nav-list">
                <a class="@NavClass("/Committee/Companies")" asp-page="/Committee/Companies">Company</a>
                <a class="@NavClass("/Committee/CompanyRequests")" asp-page="/Committee/CompanyRequests">Company Request</a>
                <a class="@NavClass("/Committee/BlacklistCompanies")" asp-page="/Committee/BlacklistCompanies">Blacklist Company</a>
            </div>
        </section>

        <section class="committee-nav-section">
            <p class="committee-nav-section-title">People & Roles</p>
            <div class="committee-nav-list">
                <a class="@NavClass("/Committee/StudentAccess")" asp-page="/Committee/StudentAccess">Student Access</a>
                <a class="@NavClass("/Committee/UniSupervisors")" asp-page="/Committee/UniSupervisors">Uni Supervisor</a>
                <a class="@NavClass("/Committee/CommitteeMembers")" asp-page="/Committee/CommitteeMembers">Committee Member</a>
            </div>
        </section>
    </div>
</div>
