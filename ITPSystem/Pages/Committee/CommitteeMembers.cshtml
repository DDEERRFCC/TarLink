@page
@model CommitteeMembersModel
@{
    ViewData["CommitteePageTitle"] = "Committee Member";

    var totalMembers = Model.Members.Count;
    var activeMembers = Model.Members.Count(x => x.is_active);
    var lockedMembers = Model.Members.Count(x => x.is_locked == true);
}

<style>
    .committee-member-page {
        display: grid;
        gap: 1rem;
        max-width: 1280px;
        margin: 0 auto;
    }

    .committee-member-banner {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 1.35rem;
        color: #fff;
        background: linear-gradient(135deg, #132238, #8f2d56 58%, #b34873);
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.14);
    }

    .committee-member-banner::after {
        content: "";
        position: absolute;
        right: -42px;
        top: -50px;
        width: 180px;
        height: 180px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
    }

    .committee-member-banner > * {
        position: relative;
        z-index: 1;
    }

    .committee-member-banner-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 1rem;
    }

    .committee-member-kicker {
        display: inline-flex;
        align-items: center;
        padding: .34rem .72rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .committee-member-title {
        margin: .55rem 0 .35rem;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        font-family: Georgia, "Times New Roman", serif;
    }

    .committee-member-copy {
        margin: 0;
        max-width: 72ch;
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.75;
    }

    .committee-member-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        text-decoration: none;
        border-radius: 999px;
        padding: .78rem 1rem;
        border: 1px solid #e6cdd7;
        background: linear-gradient(180deg, #ffffff, #f5fbff);
        color: #4f3041;
        font-weight: 700;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

    .committee-member-back-btn:hover {
        color: #6b2847;
        border-color: #d7a7ba;
        box-shadow: 0 14px 26px rgba(15, 23, 42, 0.09);
        transform: translateY(-1px);
    }

    .committee-member-back-btn::before {
        content: "<";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 999px;
        background: #f6dfe9;
        color: #7b264b;
        font-size: .9rem;
        line-height: 1;
    }

    .committee-member-banner-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
    }

    .committee-member-banner-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .8rem 1rem;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        color: #fff;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.32);
    }

    .committee-member-stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .committee-member-stat-card,
    .committee-member-table-card {
        border: 1px solid #eadce2;
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff, #fff9fb);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
    }

    .committee-member-stat-card {
        position: relative;
        overflow: hidden;
        padding: 1rem 1.05rem;
    }

    .committee-member-stat-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 5px;
        background: linear-gradient(90deg, #8f2d56, #b34873);
    }

    .committee-member-stat-label {
        color: #7a6673;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .committee-member-stat-value {
        margin-top: .35rem;
        color: #2f1724;
        font-size: 1.7rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .committee-member-stat-note {
        margin-top: .3rem;
        color: #917d89;
        font-size: .88rem;
    }

    .committee-member-table-head {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 1rem;
        padding: 1rem 1rem 0;
    }

    .committee-member-section-title {
        margin: 0;
        color: #132238;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .committee-member-section-copy {
        margin: .3rem 0 0;
        color: #7a6673;
        line-height: 1.7;
        font-size: .92rem;
    }

    .committee-member-count-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 14px;
        padding: .46rem .86rem;
        background: linear-gradient(180deg, #dbeafe, #eff6ff);
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        font-size: .84rem;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 8px 18px rgba(29, 78, 216, 0.08);
    }

    .committee-member-table-wrap {
        margin-top: 1rem;
    }

    .committee-member-table thead th {
        border-bottom-width: 1px;
        background: #faf1f5;
        color: #7a6673;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .committee-member-table tbody td {
        padding-top: .95rem;
        padding-bottom: .95rem;
        vertical-align: middle;
    }

    .committee-member-name {
        font-weight: 700;
        color: #102133;
    }

    .committee-member-meta {
        margin-top: .18rem;
        color: #917d89;
        font-size: .86rem;
    }

    .committee-member-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .28rem .68rem;
        font-size: .78rem;
        font-weight: 700;
    }

    .committee-member-status.active {
        background: #d1e7dd;
        color: #0f5132;
    }

    .committee-member-status.inactive {
        background: #fdecef;
        color: #9f305d;
    }

    .committee-member-status.locked {
        background: #f8d7da;
        color: #842029;
    }

    .committee-member-status.unlocked {
        background: #f8e8ef;
        color: #6f2847;
    }

    .committee-member-empty {
        padding: 2.5rem 1rem;
        text-align: center;
        color: #7a6673;
    }

    .committee-member-empty strong {
        display: block;
        margin-bottom: .35rem;
        color: #132238;
        font-size: 1rem;
    }

    @@media (max-width: 991.98px) {
        .committee-member-stat-grid {
            grid-template-columns: 1fr;
        }

        .committee-member-banner-top,
        .committee-member-banner-actions,
        .committee-member-table-head {
            flex-direction: column;
            align-items: stretch;
        }

        .committee-member-back-btn,
        .committee-member-banner-link {
            width: 100%;
        }
    }
</style>

<div class="committee-page">
    <div class="committee-member-page">
        <section class="committee-member-banner">
            <div class="committee-member-banner-top">
                <div>
                    <div class="committee-member-kicker">Committee Member</div>
                    <h3 class="committee-member-title">Keep committee access visible with a cleaner member directory.</h3>
                    <p class="committee-member-copy">Review the committee accounts generated through supervisor records, track whether each account is active or locked, and keep the management view aligned with the rest of the committee portal.</p>
                </div>
                <a href="/Committee/Dashboard" class="committee-member-back-btn">Back to Dashboard</a>
            </div>
            <div class="committee-member-banner-actions">
                <a asp-page="/Committee/UniSupervisors" class="committee-member-banner-link">Open University Supervisor</a>
                <a asp-page="/Committee/StudentAccess" class="committee-member-banner-link">Open Student Access</a>
            </div>
        </section>

        <section class="committee-member-stat-grid">
            <article class="committee-member-stat-card">
                <div class="committee-member-stat-label">Members</div>
                <div class="committee-member-stat-value">@totalMembers</div>
                <div class="committee-member-stat-note">Committee-linked accounts currently shown in the directory.</div>
            </article>
            <article class="committee-member-stat-card">
                <div class="committee-member-stat-label">Active Access</div>
                <div class="committee-member-stat-value">@activeMembers</div>
                <div class="committee-member-stat-note">Accounts that are currently active and ready for sign-in.</div>
            </article>
            <article class="committee-member-stat-card">
                <div class="committee-member-stat-label">Locked Accounts</div>
                <div class="committee-member-stat-value">@lockedMembers</div>
                <div class="committee-member-stat-note">Committee users that currently show a locked account state.</div>
            </article>
        </section>

        <section class="committee-member-table-card">
            <div class="committee-member-table-head">
                <div>
                    <h3 class="committee-member-section-title">Committee Directory</h3>
                    <p class="committee-member-section-copy">This view combines committee-linked system users and committee-enabled supervisor profiles into one readable directory.</p>
                </div>
                <div class="committee-member-count-pill">@totalMembers record(s)</div>
            </div>

            <div class="table-responsive committee-member-table-wrap">
                <table class="table align-middle mb-0 committee-member-table">
                    <thead>
                        <tr>
                            <th>Staff ID</th>
                            <th>Member</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Active</th>
                            <th>Locked</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Members.Any())
                        {
                            <tr>
                                <td colspan="6" class="committee-member-empty">
                                    <strong>No committee members found.</strong>
                                    Committee-linked supervisor accounts will appear here once they are created.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td class="fw-semibold text-muted">@(string.IsNullOrWhiteSpace(member.staffId) ? "-" : member.staffId)</td>
                                    <td>
                                        <div class="committee-member-name">@(string.IsNullOrWhiteSpace(member.name) ? "-" : member.name)</div>
                                    </td>
                                    <td>@member.username</td>
                                    <td>
                                        <div>@(string.IsNullOrWhiteSpace(member.email) ? "-" : member.email)</div>
                                    </td>
                                    <td>
                                        <span class="committee-member-status @(member.is_active ? "active" : "inactive")">@(member.is_active ? "Active" : "Inactive")</span>
                                    </td>
                                    <td>
                                        @{
                                            var locked = member.is_locked == true;
                                            var lockedText = member.is_locked.HasValue ? (locked ? "Locked" : "Unlocked") : "-";
                                        }
                                        @if (member.is_locked.HasValue)
                                        {
                                            <span class="committee-member-status @(locked ? "locked" : "unlocked")">@lockedText</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

