@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password - ITPSystem";
}

<style>
    .reset-shell {
        min-height: calc(100vh - 80px);
        padding: 2rem 0 2.5rem;
        background:
            radial-gradient(circle at top left, rgba(143, 45, 86, 0.16), transparent 28%),
            radial-gradient(circle at 85% 12%, rgba(15, 123, 108, 0.14), transparent 24%),
            linear-gradient(160deg, #f8f3f6 0%, #fafbfd 52%, #eef5f3 100%);
    }

    .reset-card {
        max-width: 560px;
        margin: 0 auto;
        border: 1px solid rgba(19, 34, 56, 0.1);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 24px 50px rgba(19, 34, 56, 0.12);
        padding: 2rem;
    }

    .reset-card h1 {
        margin-bottom: 0.5rem;
        color: #132238;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
    }

    .reset-card p {
        color: #5d6b7c;
        line-height: 1.7;
    }

    .reset-label {
        margin-bottom: 0.45rem;
        font-weight: 700;
        color: #25415f;
    }

    .reset-control {
        border: 1px solid #d8c8d0;
        border-radius: 16px;
        padding: 0.9rem 1rem;
        box-shadow: none;
    }

    .reset-control:focus {
        border-color: #8f2d56;
        box-shadow: 0 0 0 0.2rem rgba(143, 45, 86, 0.15);
    }

    .reset-btn {
        width: 100%;
        border: none;
        border-radius: 16px;
        padding: 0.95rem 1rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #8f2d56, #0f7b6c);
    }
</style>

<section class="reset-shell">
    <div class="container">
        <div class="reset-card">
            <h1>Reset Password</h1>
            <p>Choose a new password for your account.</p>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-success">@Model.StatusMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            @if (!Model.IsTokenValid)
            {
                <div class="alert alert-warning">
                    This reset link is invalid or has expired. Please request a new password reset link.
                </div>
                <a class="btn btn-outline-secondary" asp-page="/Login/ForgotPassword">Go to Forgot Password</a>
            }
            else
            {
                <form method="post">
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="reset-label"></label>
                        <input asp-for="NewPassword" class="form-control reset-control" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="reset-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control reset-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="reset-btn">Update Password</button>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
