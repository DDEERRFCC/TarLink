@page
@model CommitteeLoginModel
@{
    ViewData["Title"] = "Committee Login - ITPSystem";
}

<style>
    .role-login-shell {
        min-height: calc(100vh - 80px);
        padding: 2rem 0 2.5rem;
        background:
            radial-gradient(circle at top left, rgba(143, 45, 86, 0.18), transparent 28%),
            radial-gradient(circle at 85% 12%, rgba(19, 34, 56, 0.16), transparent 24%),
            linear-gradient(160deg, #f7eff4 0%, #fafbfd 52%, #f2f4f8 100%);
    }

    .role-login-card {
        overflow: hidden;
        border: 1px solid rgba(19, 34, 56, 0.1);
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 24px 50px rgba(19, 34, 56, 0.12);
    }

    .role-login-panel {
        padding: 2rem;
    }

    .role-login-brand {
        height: 100%;
        color: #fff7fb;
        background:
            radial-gradient(circle at top right, rgba(255, 209, 102, 0.12), transparent 30%),
            linear-gradient(150deg, #8f2d56 0%, #4c223c 100%);
    }

    .role-login-chip {
        display: inline-flex;
        margin-bottom: 1rem;
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .role-login-brand h1 {
        margin-bottom: 0.9rem;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.03;
    }

    .role-login-brand p {
        max-width: 34ch;
        margin-bottom: 1.4rem;
        line-height: 1.75;
        color: rgba(255, 247, 251, 0.9);
    }

    .role-login-points {
        display: grid;
        gap: 0.8rem;
        margin-bottom: 1.4rem;
    }

    .role-login-point {
        padding: 0.9rem 1rem;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.08);
    }

    .role-login-point strong {
        display: block;
        margin-bottom: 0.2rem;
    }

    .role-login-back {
        color: #fff7fb;
        text-decoration: none;
        font-weight: 700;
    }

    .role-login-back:hover {
        color: #ffd8e7;
    }

    .role-login-form h2 {
        margin-bottom: 0.35rem;
        color: #132238;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
    }

    .role-login-form p {
        color: #5d6b7c;
        line-height: 1.7;
    }

    .role-form-label {
        margin-bottom: 0.45rem;
        font-weight: 700;
        color: #25415f;
    }

    .role-form-control {
        border: 1px solid #dbc9d2;
        border-radius: 16px;
        padding: 0.9rem 1rem;
        box-shadow: none;
    }

    .role-form-control:focus {
        border-color: #8f2d56;
        box-shadow: 0 0 0 0.2rem rgba(143, 45, 86, 0.15);
    }

    .role-login-links {
        display: flex;
        justify-content: flex-start;
        gap: 1rem;
        margin: 1rem 0 1.25rem;
        font-size: 0.95rem;
    }

    .role-login-links a {
        color: #7b264b;
        text-decoration: none;
        font-weight: 600;
    }

    .role-login-links a:hover {
        text-decoration: underline;
    }

    .role-login-btn {
        width: 100%;
        border: none;
        border-radius: 16px;
        padding: 0.95rem 1rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #8f2d56, #b34873);
        box-shadow: 0 16px 26px rgba(143, 45, 86, 0.2);
    }

    @@media (max-width: 991.98px) {
        .role-login-panel {
            padding: 1.5rem;
        }
    }
</style>

<section class="role-login-shell">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="role-login-card">
                    <div class="row g-0">
                        <div class="col-lg-6">
                            <div class="role-login-panel role-login-brand">
                                <div class="role-login-chip">Committee Portal</div>
                                <h1>Manage internship records with control.</h1>
                                <p>
                                    Access the committee workspace to oversee records, coordinate supervisors,
                                    and support programme administration for Industrial Training.
                                </p>

                                <div class="role-login-points">
                                    <div class="role-login-point">
                                        <strong>Programme oversight</strong>
                                        <span>Monitor student records, approvals, and key internship administration tasks.</span>
                                    </div>
                                    <div class="role-login-point">
                                        <strong>Coordination tools</strong>
                                        <span>Manage imports, supervisors, and reporting flows in one committee workspace.</span>
                                    </div>
                                </div>

                                <a class="role-login-back" asp-page="/Index">Back to Home</a>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="role-login-panel role-login-form">
                                <h2>Committee Login</h2>
                                <p>Sign in with your committee email or username to continue.</p>

                                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                                }

                                <form method="post">
                                    <div class="mb-3">
                                        <label class="role-form-label">Email or Username</label>
                                        <input type="text" asp-for="Email" class="form-control role-form-control"
                                               placeholder="e.g. committee1@tarc.edu.my" required />
                                    </div>

                                    <div class="mb-3">
                                        <label class="role-form-label">Password</label>
                                        <input type="password" asp-for="Password" class="form-control role-form-control"
                                               placeholder="Enter your password" required />
                                    </div>

                                    <div class="role-login-links">
                                        <a asp-page="/Login/ForgotPassword">Forgot Password?</a>
                                    </div>

                                    <button type="submit" class="role-login-btn">Enter Committee Portal</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
