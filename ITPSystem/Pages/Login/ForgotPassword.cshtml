@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password - ITPSystem";
}

<style>
    .reset-shell {
        min-height: calc(100vh - 80px);
        padding: 2rem 0 2.5rem;
        background:
            radial-gradient(circle at top left, rgba(15, 123, 108, 0.18), transparent 28%),
            radial-gradient(circle at 85% 12%, rgba(201, 106, 22, 0.16), transparent 24%),
            linear-gradient(160deg, #eef6f6 0%, #fafbfd 52%, #f5f1e8 100%);
    }

    .reset-card {
        border: 1px solid rgba(19, 34, 56, 0.1);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 24px 50px rgba(19, 34, 56, 0.12);
        overflow: hidden;
    }

    .reset-panel {
        padding: 2rem;
    }

    .reset-side {
        height: 100%;
        color: #fffaf1;
        background: linear-gradient(150deg, #132238 0%, #0f7b6c 100%);
    }

    .reset-chip {
        display: inline-flex;
        margin-bottom: 1rem;
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .reset-side h1,
    .reset-form h2 {
        font-family: Georgia, "Times New Roman", serif;
    }

    .reset-side h1 {
        margin-bottom: 0.9rem;
        font-size: clamp(2rem, 4vw, 2.8rem);
        line-height: 1.05;
    }

    .reset-side p,
    .reset-form p {
        line-height: 1.75;
    }

    .reset-side p {
        color: rgba(255, 250, 241, 0.9);
    }

    .reset-points {
        display: grid;
        gap: 0.8rem;
        margin: 1.25rem 0;
    }

    .reset-point {
        padding: 0.9rem 1rem;
        border-radius: 18px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(255, 255, 255, 0.08);
    }

    .reset-back {
        color: #fffaf1;
        text-decoration: none;
        font-weight: 700;
    }

    .reset-form h2 {
        margin-bottom: 0.35rem;
        color: #132238;
        font-size: 2rem;
    }

    .reset-form p {
        color: #5d6b7c;
    }

    .reset-label {
        margin-bottom: 0.45rem;
        font-weight: 700;
        color: #25415f;
    }

    .reset-control {
        border: 1px solid #cfdadf;
        border-radius: 16px;
        padding: 0.9rem 1rem;
        box-shadow: none;
    }

    .reset-control:focus {
        border-color: #0f7b6c;
        box-shadow: 0 0 0 0.2rem rgba(15, 123, 108, 0.15);
    }

    .reset-btn {
        width: 100%;
        border: none;
        border-radius: 16px;
        padding: 0.95rem 1rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #132238, #0f7b6c);
    }

    .reset-links {
        margin-top: 1rem;
        text-align: center;
    }

    .reset-links a {
        color: #0d5d67;
        text-decoration: none;
        font-weight: 600;
    }
</style>

<section class="reset-shell">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="reset-card">
                    <div class="row g-0">
                        <div class="col-lg-6">
                            <div class="reset-panel reset-side">
                                <div class="reset-chip">Password Recovery</div>
                                <h1>Reset access to your ITP account.</h1>
                                <p>
                                    Enter your account email and we will prepare a password reset link for your account.
                                </p>

                                <div class="reset-points">
                                    <div class="reset-point">Works for student, supervisor, and committee accounts.</div>
                                    <div class="reset-point">Reset links expire automatically for better security.</div>
                                </div>

                                <a class="reset-back" asp-page="/Index">Back to Home</a>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="reset-panel reset-form">
                                <h2>Forgot Password</h2>
                                <p>Use the email linked to your account.</p>

                                @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                                {
                                    <div class="alert alert-success">@Model.StatusMessage</div>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                                {
                                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                                }

                                <form method="post">
                                    <div class="mb-3">
                                        <label asp-for="Email" class="reset-label"></label>
                                        <input asp-for="Email" class="form-control reset-control" placeholder="e.g. student1@tarc.edu.my" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>

                                    <button type="submit" class="reset-btn">Send Reset Link</button>
                                </form>

                                <div class="reset-links">
                                    <a asp-page="/Login/StudentLogin">Back to login pages</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
