@page
@model StudentSignupModel
@{
    ViewData["Title"] = "Student Signup";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap');

    .signup-page {
        font-family: "Manrope", "Segoe UI", sans-serif;
        min-height: calc(100vh - 80px);
        background:
            radial-gradient(circle at top left, rgba(15, 123, 108, 0.2), transparent 28%),
            radial-gradient(circle at 85% 12%, rgba(255, 209, 102, 0.22), transparent 24%),
            linear-gradient(160deg, #eef6f6 0%, #f8fbfc 52%, #edf4f7 100%);
        padding: 2rem 0 2.8rem;
    }

    .signup-shell {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .signup-form-wrap {
        border: 1px solid rgba(22, 39, 66, 0.08);
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 26px 60px rgba(22, 39, 66, 0.12);
        backdrop-filter: blur(12px);
        padding: 2rem;
    }

    .signup-form h2 {
        margin-bottom: .3rem;
        color: #132238;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
    }

    .signup-form-copy {
        color: #617387;
        line-height: 1.7;
        margin-bottom: 1.3rem;
    }

    .signup-alert {
        border-radius: 18px;
        border: 1px solid rgba(22, 39, 66, 0.08);
        padding: .95rem 1rem;
        margin-bottom: 1rem;
    }

    .signup-alert ul {
        margin: .45rem 0 0 1rem;
    }

    .signup-sections {
        display: grid;
        gap: 1rem;
    }

    .signup-section {
        border: 1px solid #e2eaf4;
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff, #fbfdff);
        padding: 1rem;
    }

    .signup-section-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1rem;
    }

    .signup-section-no {
        width: 2rem;
        height: 2rem;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #d6f4ee, #eef9f7);
        color: #0d5d67;
        font-size: .84rem;
        font-weight: 800;
    }

    .signup-section-title {
        margin: 0;
        color: #132238;
        font-size: 1rem;
        font-weight: 800;
    }

    .signup-section-copy {
        margin: .15rem 0 0;
        color: #738396;
        font-size: .9rem;
    }

    .signup-label {
        margin-bottom: .42rem;
        font-size: .82rem;
        font-weight: 800;
        color: #28415f;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .signup-input,
    .signup-select,
    .signup-textarea {
        border: 1px solid #cfdae8;
        border-radius: 16px;
        padding: .82rem .95rem;
        font-size: .94rem;
        background: #fff;
        box-shadow: none;
    }

    .signup-input:focus,
    .signup-select:focus,
    .signup-textarea:focus {
        outline: none;
        border-color: #0f7b6c;
        box-shadow: 0 0 0 .22rem rgba(15, 123, 108, 0.15);
    }

    .signup-textarea {
        min-height: 110px;
        resize: vertical;
    }

    .signup-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .8rem;
        margin-top: 1.2rem;
    }

    .signup-submit {
        border: 0;
        border-radius: 18px;
        padding: .9rem 1.2rem;
        font-weight: 800;
        text-decoration: none;
    }

    .signup-submit {
        flex: 1 1 260px;
        color: #fff;
        background: linear-gradient(135deg, #0f7b6c, #159683);
        box-shadow: 0 18px 32px rgba(15, 123, 108, 0.2);
    }

    .signup-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 180px;
        border-radius: 18px;
        padding: .9rem 1.2rem;
        font-weight: 800;
        text-decoration: none;
        background: #eef7f6;
        color: #0d5d67;
        border: 1px solid #d6e9e6;
    }

    @@media (max-width: 991.98px) {
        .signup-form-wrap {
            padding: 1.4rem;
        }
    }
</style>

<section class="signup-page">
    <div class="signup-shell">
        <div class="signup-form-wrap">
            <div class="signup-form">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                    <div>
                        <h2>Student Internship Signup</h2>
                        <p class="signup-form-copy mb-0">Fill in your details carefully. You can update most profile details later from your dashboard after logging in.</p>
                    </div>
                    <a asp-page="/Login/StudentLogin" class="signup-secondary">Back to Student Login</a>
                </div>

                @if (Model.Message != null)
                {
                    <div class="alert alert-success signup-alert">@Model.Message</div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger signup-alert">
                        <strong>Please fix the following errors:</strong>
                        <ul>
                            @foreach (var entry in ViewData.ModelState)
                            {
                                foreach (var error in entry.Value.Errors)
                                {
                                    <li>@entry.Key: @error.ErrorMessage</li>
                                }
                            }
                        </ul>
                    </div>
                }

                <form method="post">
                    <div class="signup-sections">
                        <section class="signup-section">
                            <div class="signup-section-header">
                                <span class="signup-section-no">1</span>
                                <div>
                                    <h5 class="signup-section-title">Academic Details</h5>
                                    <p class="signup-section-copy">Match your signup to the correct study route and active internship cohort.</p>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="signup-label">Level</label>
                                    <select asp-for="Student.level" class="form-select signup-select">
                                        <option value="">-- Select One --</option>
                                        <option value="1">Diploma</option>
                                        <option value="2">Degree</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Cohort</label>
                                    <select asp-for="Student.cohortId" class="form-select signup-select">
                                        <option value="">-- Select One --</option>
                                        @foreach (var c in Model.Cohorts)
                                        {
                                            <option value="@c.cohort_id" selected="@(Model.Student.cohortId == c.cohort_id ? "selected" : null)">
                                                @c.description
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Programme</label>
                                    <select asp-for="Student.programme" class="form-select signup-select">
                                        <option value="">-- Select One --</option>
                                        <option value="RSD">RSD</option>
                                        <option value="RIT">RIT</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Tutorial Group</label>
                                    <input asp-for="Student.groupNo" class="form-control signup-input" placeholder="1 - 5" />
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Student ID</label>
                                    <input asp-for="Student.studentID" class="form-control signup-input" />
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Student Email</label>
                                    <input asp-for="Student.studentEmail" class="form-control signup-input" />
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">CGPA</label>
                                    <input asp-for="Student.CGPA" type="number" step="0.01" class="form-control signup-input" />
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">University Supervisor</label>
                                    <input asp-for="Student.ucSupervisor" class="form-control signup-input" />
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Supervisor Email</label>
                                    <input asp-for="Student.ucSupervisorEmail" class="form-control signup-input" />
                                </div>
                            </div>
                        </section>

                        <section class="signup-section">
                            <div class="signup-section-header">
                                <span class="signup-section-no">2</span>
                                <div>
                                    <h5 class="signup-section-title">Personal Data</h5>
                                    <p class="signup-section-copy">Provide your identification and basic personal information.</p>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="signup-label">NRIC</label>
                                    <input asp-for="ICNumber" class="form-control signup-input" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="signup-label">Full Name</label>
                                    <input asp-for="Student.studentName" class="form-control signup-input" />
                                </div>
                                <div class="col-md-6">
                                    <label class="signup-label">Gender</label>
                                    <select asp-for="Student.gender" class="form-select signup-select">
                                        <option value="">-- Select One --</option>
                                        <option value="M">Male</option>
                                        <option value="F">Female</option>
                                        <option value="O">Other</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="signup-label">Own Transport</label>
                                    <select asp-for="Student.ownTransport" class="form-select signup-select">
                                        <option value="">-- Select One --</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="signup-label">Health Remark</label>
                                    <textarea asp-for="Student.healthRemark" class="form-control signup-textarea"></textarea>
                                </div>
                            </div>
                        </section>

                        <section class="signup-section">
                            <div class="signup-section-header">
                                <span class="signup-section-no">3</span>
                                <div>
                                    <h5 class="signup-section-title">Contact Information</h5>
                                    <p class="signup-section-copy">Add the best contact details for internship communication and records.</p>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="signup-label">Personal Email</label>
                                    <input asp-for="Student.personalEmail" class="form-control signup-input" />
                                </div>
                                <div class="col-md-6">
                                    <label class="signup-label">Mobile Number</label>
                                    <input asp-for="Student.permanentContact" class="form-control signup-input" />
                                </div>
                                <div class="col-md-6">
                                    <label class="signup-label">Term Address</label>
                                    <textarea asp-for="Student.tempAddress" class="form-control signup-textarea"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="signup-label">Permanent Address</label>
                                    <textarea asp-for="Student.permanentAddress" class="form-control signup-textarea"></textarea>
                                </div>
                            </div>
                        </section>

                        <section class="signup-section">
                            <div class="signup-section-header">
                                <span class="signup-section-no">4</span>
                                <div>
                                    <h5 class="signup-section-title">Technical Knowledge</h5>
                                    <p class="signup-section-copy">Give a simple overview of your current technical strengths.</p>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="signup-label">Programming</label>
                                    <textarea asp-for="Student.programmingKnowledge" class="form-control signup-textarea"></textarea>
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Database</label>
                                    <textarea asp-for="Student.databaseKnowledge" class="form-control signup-textarea"></textarea>
                                </div>
                                <div class="col-md-4">
                                    <label class="signup-label">Networking</label>
                                    <textarea asp-for="Student.networkingKnowledge" class="form-control signup-textarea"></textarea>
                                </div>
                            </div>
                        </section>
                    </div>

                    <div class="signup-actions">
                        <button type="submit" class="signup-submit">Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
